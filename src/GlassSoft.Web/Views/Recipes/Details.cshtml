@model GlassSoft.Application.DTOs.Recipe.RecipeDto
@{
    ViewData["Title"] = $"Reçete - {Model.Code}";
    ViewData["Breadcrumb"] = "Reçeteler";
}

<div class="row">
    <div class="col-md-8">
        <!-- Genel Bilgiler -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-layer-group mr-2"></i>@Model.Code - @Model.Name</h3>
                <div class="card-tools">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit mr-1"></i> Düzenle
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" id="recipeDeleteForm">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-danger btn-sm ml-1" id="btnRecipeDelete">
                            <i class="fas fa-trash mr-1"></i> Sil
                        </button>
                    </form>
                </div>
                <script>
                    $(function() {
                        $('#btnRecipeDelete').on('click', function() {
                            Swal.fire({
                                title: 'Reçeteyi sil?',
                                html: '<b>@Model.Code</b> reçetesini silmek istediğinize emin misiniz?',
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonText: 'Evet, sil',
                                cancelButtonText: 'Vazgeç',
                                confirmButtonColor: '#dc3545'
                            }).then(function(r) { if (r.isConfirmed) $('#recipeDeleteForm').submit(); });
                        });
                    });
                </script>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Kod:</strong></div>
                    <div class="col-md-3">@Model.Code</div>
                    <div class="col-md-3"><strong>Birim Fiyat:</strong></div>
                    <div class="col-md-3">@Model.BaseUnitPrice.ToString("N2") TL/m²</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Ürün:</strong></div>
                    <div class="col-md-3">@(Model.ProductItemName ?? "-")</div>
                    <div class="col-md-3"><strong>Durum:</strong></div>
                    <div class="col-md-3">
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Pasif</span>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="row mt-2">
                        <div class="col-md-3"><strong>Açıklama:</strong></div>
                        <div class="col-md-9">@Model.Description</div>
                    </div>
                }
            </div>
        </div>

        <!-- Katmanlar -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-bars mr-2"></i>Katmanlar (@Model.Layers.Count)</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead>
                        <tr>
                            <th style="width: 60px">Sıra</th>
                            <th>Tip</th>
                            <th>Ürün</th>
                            <th>Kalınlık</th>
                            <th>Adet/Birim</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var layer in Model.Layers)
                        {
                            <tr>
                                <td class="text-center"><span class="badge badge-primary">@layer.SortOrder</span></td>
                                <td>
                                    @if (layer.LayerType == "Glass")
                                    {
                                        <span class="badge badge-info"><i class="fas fa-square mr-1"></i>Cam</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning"><i class="fas fa-grip-lines mr-1"></i>Ara Parça</span>
                                    }
                                </td>
                                <td>@layer.ProductItemName</td>
                                <td>@layer.ThicknessMm mm</td>
                                <td>@layer.QuantityPerUnit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Sarf Malzemeler -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-flask mr-2"></i>Sarf Malzemeler (@Model.Consumables.Count)</h3>
            </div>
            <div class="card-body p-0">
                @if (Model.Consumables.Any())
                {
                    <table class="table table-bordered table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Malzeme</th>
                                <th>Tüketim Formülü</th>
                                <th>Açıklama</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cons in Model.Consumables)
                            {
                                <tr>
                                    <td>@cons.ProductItemName</td>
                                    <td><code>@cons.ConsumptionFormula</code></td>
                                    <td>@(cons.Description ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3 text-muted">Sarf malzeme tanımlanmamış.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Görsel Katman Temsili -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-th-list mr-2"></i>Katman Görünümü</h3>
            </div>
            <div class="card-body text-center">
                @foreach (var layer in Model.Layers)
                {
                    var bgColor = layer.LayerType == "Glass" ? "#17a2b8" : "#ffc107";
                    var textColor = layer.LayerType == "Glass" ? "white" : "black";
                    var height = Math.Max(20, (int)(layer.ThicknessMm * 3));
                    <div style="background-color: @bgColor; color: @textColor; height: @(height)px; line-height: @(height)px; margin: 2px 0; border-radius: 4px; font-size: 0.85rem;">
                        @layer.ProductItemName (@(layer.ThicknessMm)mm)
                    </div>
                }
                <div class="mt-3">
                    <small class="text-muted">
                        <span class="badge badge-info">Cam</span>
                        <span class="badge badge-warning">Ara Parça</span>
                    </small>
                </div>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-secondary btn-block"><i class="fas fa-arrow-left mr-1"></i> Listeye Dön</a>
    </div>
</div>
