@model IEnumerable<GlassSoft.Application.DTOs.Recipe.RecipeDto>
@{
    ViewData["Title"] = "Reçeteler";
    ViewData["Breadcrumb"] = "Reçeteler";
}

@if (TempData["Success"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function() { toastr.success('@TempData["Success"]'); });</script>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-layer-group mr-2"></i>Reçeteler</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus mr-1"></i> Yeni Reçete
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="tblRecipes" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Reçete Adı</th>
                    <th>Ürün</th>
                    <th>Birim Fiyat</th>
                    <th>Katman</th>
                    <th>Sarf</th>
                    <th>Durum</th>
                    <th style="width: 80px">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Code</strong></td>
                        <td>@item.Name</td>
                        <td>
                            @if (item.ProductItemName != null)
                            {
                                <span class="badge badge-primary">@item.ProductItemName</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-right">@item.BaseUnitPrice.ToString("N2")</td>
                        <td class="text-center"><span class="badge badge-info">@item.LayerCount katman</span></td>
                        <td class="text-center"><span class="badge badge-warning">@item.ConsumableCount sarf</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="Detay">
                                <i class="fas fa-eye mr-1"></i> Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$(document).ready(function() { $('#tblRecipes').DataTable({ "order": [[0, "desc"]] }); });</script>
}
