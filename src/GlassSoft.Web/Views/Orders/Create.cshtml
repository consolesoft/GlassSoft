@model GlassSoft.Application.DTOs.Sales.OrderCreateDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Yeni Sipariş";
    ViewData["Breadcrumb"] = "Satış";
}

<form asp-action="Create" method="post" id="orderForm">
    <div class="row">
        <div class="col-md-8">
            <!-- Sipariş Bilgileri -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-plus mr-2"></i>Yeni Sipariş</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="CustomerId">Müşteri</label>
                                <select asp-for="CustomerId" asp-items="@ViewBag.Customers" class="form-control select2" required>
                                    <option value="">Seçiniz...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="OrderDate">Sipariş Tarihi</label>
                                <input asp-for="OrderDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="DeliveryDate">Termin Tarihi</label>
                                <input asp-for="DeliveryDate" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group">
                                <label asp-for="Currency">Döviz</label>
                                <select asp-for="Currency" class="form-control no-select2">
                                    <option value="TRY">TRY</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-1">
                            <div class="form-group">
                                <label asp-for="TaxRate">KDV %</label>
                                <select asp-for="TaxRate" class="form-control no-select2" id="taxRateSelect">
                                    <option value="0" selected>0</option>
                                    <option value="1">1</option>
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrderCustomerName">Sipariş Müşterisi</label>
                        <input asp-for="OrderCustomerName" class="form-control" placeholder="Örn: Mağaza adı, kontak kişi, alt müşteri" />
                        <small class="text-muted">Cari/firma dışında siparişi veren özel müşteri adı (çıktılarda görünür)</small>
                    </div>
                    <div class="form-group">
                        <label asp-for="Notes">Notlar</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            <!-- Sipariş Kalemleri -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-list mr-2"></i>Sipariş Kalemleri</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("DownloadTemplate")" class="btn btn-success btn-sm mr-1" title="Excel Şablon İndir">
                            <i class="fas fa-file-excel mr-1"></i> Şablon
                        </a>
                        <button type="button" class="btn btn-warning btn-sm mr-1" data-toggle="modal" data-target="#excelModal" title="Excel'den Aktar">
                            <i class="fas fa-upload mr-1"></i> Excel Aktar
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" id="btnAddLine">
                            <i class="fas fa-plus mr-1"></i> Kalem Ekle
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0" id="tblLines">
                        <thead>
                            <tr>
                                <th style="width: 22%">Ürün/Reçete</th>
                                <th style="width: 9%">En (mm)</th>
                                <th style="width: 9%">Boy (mm)</th>
                                <th style="width: 7%">Adet</th>
                                <th style="width: 8%">Satır m²</th>
                                <th style="width: 10%">Birim Fiyat</th>
                                <th style="width: 10%">Toplam</th>
                                <th style="width: 9%">Not</th>
                                <th style="width: 8%">Poz No</th>
                                <th style="width: 8%"></th>
                            </tr>
                        </thead>
                        <tbody id="linesBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>Bilgi</h3>
                </div>
                <div class="card-body">
                    <p class="small text-muted">Sipariş kalemlerinde ürün veya reçete seçebilirsiniz. En x Boy ölçüsünü mm cinsinden girin.</p>
                    <p class="small text-muted">Birim fiyat m² başınadır. Toplam = Birim Fiyat x m² x Adet</p>
                    <p class="small text-muted"><strong>Perakende:</strong> En/Boy boş bırakılırsa Toplam = Birim Fiyat x Adet</p>
                    <p class="small text-muted">Son satırda <kbd>↓</kbd> yeni kalem, <kbd>Shift+↓</kbd> kopyalar.</p>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Toplam m²:</span>
                        <strong id="totalM2">0.00</strong>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Ara Toplam:</span>
                        <strong id="grandTotal">0.00</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>KDV (<span id="taxRateDisplay">20</span>%):</span>
                        <strong id="taxAmount">0.00</strong>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between">
                        <h5 class="mb-0">Genel Toplam:</h5>
                        <h4 class="mb-0 text-primary" id="grandTotalWithTax">0.00</h4>
                    </div>
                </div>
            </div>

            <button type="button" id="btnOrderSave" class="btn btn-primary btn-block btn-lg"><i class="fas fa-save mr-1"></i> Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary btn-block"><i class="fas fa-arrow-left mr-1"></i> Geri</a>
        </div>
    </div>
</form>

<!-- Fiyat Geçmişi Modal -->
<div class="modal fade" id="priceHistoryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-history mr-2"></i>Son Satış Fiyatları</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <table class="table table-bordered table-striped mb-0" id="priceHistoryTable">
                    <thead>
                        <tr>
                            <th>Sipariş</th>
                            <th>Tarih</th>
                            <th>Müşteri</th>
                            <th>En×Boy</th>
                            <th>Adet</th>
                            <th>Birim Fiyat</th>
                        </tr>
                    </thead>
                    <tbody id="priceHistoryBody"></tbody>
                </table>
                <div id="priceHistoryEmpty" class="text-center p-3 text-muted" style="display:none">
                    <i class="fas fa-info-circle mr-1"></i> Bu ürün için satış geçmişi bulunamadı.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Excel Import Modal -->
<div class="modal fade" id="excelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-file-excel mr-2"></i>Excel'den Toplu Aktar</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">
                    Önce <a href="@Url.Action("DownloadTemplate")">şablonu indirin</a>, doldurun, ardından buradan yükleyin.
                </p>
                <div class="form-group">
                    <label>Excel Dosyası (.xlsx)</label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="excelFile" accept=".xlsx,.xls">
                        <label class="custom-file-label" for="excelFile">Dosya seçin...</label>
                    </div>
                </div>
                <div id="excelResult" style="display: none;">
                    <div class="alert alert-info" id="excelInfo"></div>
                    <div id="excelErrors" style="display: none;">
                        <div class="alert alert-warning small" id="excelErrorList"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="btnImportExcel" disabled>
                    <i class="fas fa-upload mr-1"></i> Aktar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    $(document).ready(function() {
        $('.select2').select2({ theme: 'default' });

        var productsJson = '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(((SelectList)ViewBag.Products).Select(x => new { x.Value, x.Text })))';
        var recipesJson = '@Html.Raw(System.Text.Json.JsonSerializer.Serialize(((SelectList)ViewBag.Recipes).Select(x => new { x.Value, x.Text })))';
        var products = JSON.parse(productsJson);
        var recipes = JSON.parse(recipesJson);
        var productPrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProductPrices as Dictionary<int, decimal>));
        var recipePrices = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.RecipePrices as Dictionary<int, decimal>));
        var featureDefs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.FeatureDefinitions));

        function buildItemSelect(nameProduct, nameRecipe) {
            var html = '<div class="d-flex align-items-center">';
            html += '<select class="form-control form-control-sm item-select flex-grow-1" data-product-name="' + nameProduct + '" data-recipe-name="' + nameRecipe + '">';
            html += '<option value="">Seçiniz...</option>';
            if (products.length > 0) {
                html += '<optgroup label="Ürünler">';
                products.forEach(function(p) { html += '<option value="P_' + p.Value + '">' + p.Text + '</option>'; });
                html += '</optgroup>';
            }
            if (recipes.length > 0) {
                html += '<optgroup label="Reçeteler">';
                recipes.forEach(function(r) { html += '<option value="R_' + r.Value + '">[Reçete] ' + r.Text + '</option>'; });
                html += '</optgroup>';
            }
            html += '</select>';
            html += '<button type="button" class="btn btn-outline-info btn-xs ml-1 btn-price-history" title="Son satış fiyatları" style="display:none"><i class="fas fa-history"></i></button>';
            html += '</div>';
            html += '<input type="hidden" name="' + nameProduct + '" />';
            html += '<input type="hidden" name="' + nameRecipe + '" />';
            return html;
        }

        function showPriceHistory(type, id) {
            $('#priceHistoryBody').empty();
            $('#priceHistoryEmpty').hide();
            $('#priceHistoryModal').modal('show');
            $.getJSON('@Url.Action("GetPriceHistory")', { type: type, id: id }, function(data) {
                if (data.length === 0) {
                    $('#priceHistoryEmpty').show();
                    return;
                }
                data.forEach(function(h) {
                    $('#priceHistoryBody').append(
                        '<tr><td>' + h.orderNumber + '</td><td>' + h.orderDate + '</td><td>' + h.customerTitle +
                        '</td><td>' + h.widthMm + '×' + h.heightMm + '</td><td>' + h.quantity +
                        '</td><td class="text-right"><strong>' + parseFloat(h.unitPrice).toFixed(2) + '</strong></td></tr>'
                    );
                });
            });
        }

        $(document).on('click', '.btn-price-history', function() {
            var val = $(this).closest('td').find('.item-select').val();
            if (val && val.startsWith('P_')) showPriceHistory('P', val.substring(2));
            else if (val && val.startsWith('R_')) showPriceHistory('R', val.substring(2));
        });

        var lineIndex = 0;
        var minM2 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MinM2 ?? 0m));

        function calcLineTotal(row) {
            var wVal = row.find('input[name$=".WidthMm"]').val();
            var hVal = row.find('input[name$=".HeightMm"]').val();
            var w = parseFloat(wVal) || 0;
            var h = parseFloat(hVal) || 0;
            var qty = parseInt(row.find('input[name$=".Quantity"]').val()) || 0;
            var price = parseFloat(row.find('input[name$=".UnitPrice"]').val()) || 0;
            var isRetail = (!wVal && !hVal) || (w === 0 && h === 0);
            var total;
            if (isRetail) {
                row.find('.totalarea-display').html('<span class="text-muted">-</span>');
                row.removeClass('table-warning');
                total = qty * price;
            } else {
                var areaM2 = (w / 1000) * (h / 1000);
                var effectiveM2 = areaM2;
                var totalAreaM2 = areaM2 * qty;
                if (minM2 > 0 && areaM2 > 0 && areaM2 < minM2) {
                    effectiveM2 = minM2;
                    row.find('.totalarea-display').html(totalAreaM2.toFixed(4) + ' <i class="fas fa-exclamation-triangle text-warning" title="Min m² uygulandı"></i>');
                    row.addClass('table-warning');
                } else {
                    row.find('.totalarea-display').text(totalAreaM2.toFixed(4));
                    row.removeClass('table-warning');
                }
                row.data('totalM2', totalAreaM2);
                total = effectiveM2 * qty * price;
            }
            // Özellik toplamını ekle
            var featureRow = row.next('.feature-row');
            if (featureRow.length) {
                var featureTotal = 0;
                featureRow.find('.feature-line-total').each(function() { featureTotal += parseFloat($(this).text()) || 0; });
                total += featureTotal;
            }
            row.find('.line-total').text(total.toFixed(2));
            calcGrandTotal();
        }
        function calcGrandTotal() {
            var sum = 0;
            var totalM2 = 0;
            $('#linesBody .line-total').each(function() { sum += parseFloat($(this).text()) || 0; });
            $('#linesBody tr').each(function() {
                var m2 = $(this).data('totalM2');
                if (m2) totalM2 += parseFloat(m2) || 0;
            });
            $('#totalM2').text(totalM2.toFixed(2));
            $('#grandTotal').text(sum.toFixed(2));
            var taxRate = parseInt($('#taxRateSelect').val()) || 0;
            var taxAmount = sum * taxRate / 100;
            $('#taxRateDisplay').text(taxRate);
            $('#taxAmount').text(taxAmount.toFixed(2));
            $('#grandTotalWithTax').text((sum + taxAmount).toFixed(2));
        }

        $('#taxRateSelect').on('change', function() { calcGrandTotal(); });

        function buildFeatureSelect() {
            var html = '<select class="form-control form-control-sm feature-select">';
            html += '<option value="">Özellik seçin...</option>';
            featureDefs.forEach(function(f) {
                html += '<option value="' + f.id + '" data-price="' + f.unitPrice + '">' + f.name + ' (' + parseFloat(f.unitPrice).toFixed(2) + ')</option>';
            });
            html += '</select>';
            return html;
        }

        function buildLineRow(idx, productId, recipeId, w, h, qty, price, pozNo, notes) {
            return '<tr class="line-row" data-line-idx="' + idx + '">' +
                '<td>' + buildItemSelect('Lines[' + idx + '].ProductItemId', 'Lines[' + idx + '].RecipeId') + '</td>' +
                '<td><input type="number" name="Lines[' + idx + '].WidthMm" step="1" class="form-control form-control-sm calc-input" placeholder="En" value="' + (w || '') + '" /></td>' +
                '<td><input type="number" name="Lines[' + idx + '].HeightMm" step="1" class="form-control form-control-sm calc-input" placeholder="Boy" value="' + (h || '') + '" /></td>' +
                '<td><input type="number" name="Lines[' + idx + '].Quantity" class="form-control form-control-sm calc-input" value="' + (qty || 1) + '" /></td>' +
                '<td class="text-right align-middle"><span class="totalarea-display small">0.0000</span></td>' +
                '<td><input type="number" name="Lines[' + idx + '].UnitPrice" step="0.01" class="form-control form-control-sm calc-input" placeholder="0.00" value="' + (price || '') + '" /></td>' +
                '<td class="text-right align-middle"><strong class="line-total">0.00</strong></td>' +
                '<td><input type="text" name="Lines[' + idx + '].Notes" class="form-control form-control-sm" placeholder="Not" value="' + (notes || '') + '" /></td>' +
                '<td><input type="text" name="Lines[' + idx + '].PozNo" class="form-control form-control-sm" placeholder="Poz" value="' + (pozNo || '') + '" /></td>' +
                '<td class="text-nowrap">' +
                    '<button type="button" class="btn btn-outline-secondary btn-xs btn-toggle-features mr-1" title="Özellikler"><i class="fas fa-tags"></i></button>' +
                    '<button type="button" class="btn btn-danger btn-xs btn-remove-row"><i class="fas fa-times"></i></button>' +
                '</td>' +
                '</tr>';
        }

        function buildFeatureRow(lineIdx) {
            return '<tr class="feature-row" data-line-idx="' + lineIdx + '" style="display:none">' +
                '<td colspan="10" class="bg-light p-2">' +
                    '<div class="d-flex align-items-center mb-1">' +
                        '<small class="text-muted mr-2"><i class="fas fa-tags mr-1"></i>Özellikler:</small>' +
                        '<button type="button" class="btn btn-outline-primary btn-xs btn-add-feature"><i class="fas fa-plus mr-1"></i>Ekle</button>' +
                    '</div>' +
                    '<div class="features-container"></div>' +
                '</td>' +
                '</tr>';
        }

        function addFeatureEntry(container, lineIdx) {
            var fi = container.find('.feature-entry').length;
            var html = '<div class="feature-entry d-flex align-items-center mb-1">' +
                buildFeatureSelect() +
                '<input type="number" class="form-control form-control-sm feature-qty ml-1" style="width:60px" placeholder="Adet" value="1" min="1" />' +
                '<input type="hidden" class="feature-def-id" name="Lines[' + lineIdx + '].Features[' + fi + '].FeatureDefinitionId" />' +
                '<input type="hidden" class="feature-unit-price" name="Lines[' + lineIdx + '].Features[' + fi + '].UnitPrice" />' +
                '<input type="hidden" class="feature-qty-hidden" name="Lines[' + lineIdx + '].Features[' + fi + '].Quantity" value="1" />' +
                '<span class="ml-2 small feature-line-total text-primary font-weight-bold">0.00</span>' +
                '<button type="button" class="btn btn-outline-danger btn-xs ml-1 btn-remove-feature"><i class="fas fa-times"></i></button>' +
                '</div>';
            container.append(html);
        }

        // Toggle features
        $(document).on('click', '.btn-toggle-features', function() {
            var lineRow = $(this).closest('.line-row');
            var lineIdx = lineRow.data('line-idx');
            var featureRow = lineRow.next('.feature-row');
            if (!featureRow.length) {
                featureRow = $(buildFeatureRow(lineIdx));
                lineRow.after(featureRow);
            }
            featureRow.toggle();
            $(this).toggleClass('btn-outline-secondary btn-secondary');
        });

        // Add feature entry
        $(document).on('click', '.btn-add-feature', function() {
            var featureRow = $(this).closest('.feature-row');
            var lineIdx = featureRow.data('line-idx');
            addFeatureEntry(featureRow.find('.features-container'), lineIdx);
        });

        // Feature select change
        $(document).on('change', '.feature-select', function() {
            var entry = $(this).closest('.feature-entry');
            var defId = $(this).val();
            var price = $(this).find(':selected').data('price') || 0;
            entry.find('.feature-def-id').val(defId);
            entry.find('.feature-unit-price').val(price);
            calcFeatureTotal(entry);
        });

        // Feature qty change
        $(document).on('input', '.feature-qty', function() {
            var entry = $(this).closest('.feature-entry');
            entry.find('.feature-qty-hidden').val($(this).val());
            calcFeatureTotal(entry);
        });

        function calcFeatureTotal(entry) {
            var price = parseFloat(entry.find('.feature-unit-price').val()) || 0;
            var qty = parseInt(entry.find('.feature-qty').val()) || 0;
            var total = price * qty;
            entry.find('.feature-line-total').text(total.toFixed(2));
            // Üst satırı yeniden hesapla
            var featureRow = entry.closest('.feature-row');
            var lineRow = featureRow.prev('.line-row');
            if (lineRow.length) calcLineTotal(lineRow);
        }

        // Remove feature
        $(document).on('click', '.btn-remove-feature', function() {
            var featureRow = $(this).closest('.feature-row');
            $(this).closest('.feature-entry').remove();
            // Reindex feature names
            var lineIdx = featureRow.data('line-idx');
            featureRow.find('.feature-entry').each(function(fi) {
                $(this).find('.feature-def-id').attr('name', 'Lines[' + lineIdx + '].Features[' + fi + '].FeatureDefinitionId');
                $(this).find('.feature-unit-price').attr('name', 'Lines[' + lineIdx + '].Features[' + fi + '].UnitPrice');
                $(this).find('.feature-qty-hidden').attr('name', 'Lines[' + lineIdx + '].Features[' + fi + '].Quantity');
            });
            var lineRow = featureRow.prev('.line-row');
            if (lineRow.length) calcLineTotal(lineRow);
        });

        $('#btnAddLine').click(function() {
            var row = buildLineRow(lineIndex, '', '', '', '', 1, '', '', '');
            $('#linesBody').append(row);
            lineIndex++;
        });

        $(document).on('input', '.calc-input', function() {
            calcLineTotal($(this).closest('tr'));
        });

        $(document).on('change', '.item-select', function() {
            var val = $(this).val();
            var row = $(this).closest('tr');
            var td = $(this).closest('td');
            var productInput = td.find('input[name$=".ProductItemId"]');
            var recipeInput = td.find('input[name$=".RecipeId"]');
            var priceInput = row.find('input[name$=".UnitPrice"]');
            var histBtn = td.find('.btn-price-history');
            productInput.val('');
            recipeInput.val('');
            if (val && val.startsWith('P_')) {
                var pid = val.substring(2);
                productInput.val(pid);
                if (productPrices[pid]) priceInput.val(productPrices[pid]);
                histBtn.show();
            } else if (val && val.startsWith('R_')) {
                var rid = val.substring(2);
                recipeInput.val(rid);
                if (recipePrices[rid]) priceInput.val(recipePrices[rid]);
                histBtn.show();
            } else {
                histBtn.hide();
            }
            calcLineTotal(row);
        });

        $(document).on('click', '.btn-remove-row', function() {
            var row = $(this).closest('tr');
            var featureRow = row.next('.feature-row');
            if (featureRow.length) featureRow.remove();
            row.remove();
            calcGrandTotal();
        });

        // Excel import
        var parsedLines = [];
        $('#excelFile').on('change', function() {
            var fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').html(fileName);
            if (!fileName) return;
            var formData = new FormData();
            formData.append('file', this.files[0]);
            $.ajax({
                url: '@Url.Action("ImportExcel")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function(res) {
                    if (res.success) {
                        parsedLines = res.lines;
                        var matched = parsedLines.filter(function(l) { return l.isMatched; }).length;
                        var total = parsedLines.length;
                        $('#excelInfo').html('<strong>' + total + '</strong> satır okundu, <strong>' + matched + '</strong> tanesi eşleşti.');
                        var errors = parsedLines.filter(function(l) { return !l.isMatched; });
                        if (errors.length > 0) {
                            var errHtml = errors.map(function(e) { return '<li>' + e.itemCode + ': ' + e.matchError + '</li>'; }).join('');
                            $('#excelErrorList').html('<ul class="mb-0">' + errHtml + '</ul>');
                            $('#excelErrors').show();
                        } else {
                            $('#excelErrors').hide();
                        }
                        $('#excelResult').show();
                        $('#btnImportExcel').prop('disabled', matched === 0);
                    } else {
                        $('#excelInfo').html('<span class="text-danger">' + res.error + '</span>');
                        $('#excelResult').show();
                    }
                }
            });
        });

        $('#btnImportExcel').click(function() {
            parsedLines.filter(function(l) { return l.isMatched; }).forEach(function(l) {
                var pId = l.matchedProductItemId || '';
                var rId = l.matchedRecipeId || '';
                var row = buildLineRow(lineIndex, pId, rId, l.widthMm, l.heightMm, l.quantity, l.unitPrice, '', '');
                $('#linesBody').append(row);
                var selectVal = pId ? 'P_' + pId : (rId ? 'R_' + rId : '');
                var $lastRow = $('#linesBody tr.line-row:last');
                $lastRow.find('.item-select').val(selectVal);
                $lastRow.find('input[name$=".ProductItemId"]').val(pId);
                $lastRow.find('input[name$=".RecipeId"]').val(rId);
                calcLineTotal($lastRow);
                lineIndex++;
            });
            $('#excelModal').modal('hide');
            toastr.success(parsedLines.filter(function(l) { return l.isMatched; }).length + ' kalem aktarıldı.');
        });

        // Kısayol: Aşağı ok ile yeni kalem, Shift+Aşağı ok ile satır kopyala
        $(document).on('keydown', function(e) {
            if (e.key === 'ArrowDown' && !e.ctrlKey && !e.altKey) {
                var $focused = $(document.activeElement);
                // Feature row veya select içindeyse atla
                if ($focused.closest('.feature-row').length || $focused.is('select')) return;
                var $row = $focused.closest('#linesBody tr.line-row');
                if (!$row.length) return;
                // Son line-row mu kontrol et
                var $lastLineRow = $('#linesBody tr.line-row:last');
                if ($row.data('line-idx') === $lastLineRow.data('line-idx')) {
                    e.preventDefault();
                    if (e.shiftKey) {
                        copyLine($row);
                    } else {
                        $('#btnAddLine').click();
                    }
                    var inputClass = $focused.attr('name') ? $focused.attr('name').replace(/Lines\[\d+\]\./, '') : '';
                    if (inputClass) {
                        setTimeout(function() {
                            var $newLastRow = $('#linesBody tr.line-row:last');
                            $newLastRow.find('input[name$=".' + inputClass + '"]').focus();
                        }, 50);
                    }
                }
            }
        });

        function copyLine(sourceRow) {
            var productVal = sourceRow.find('.item-select').val() || '';
            var productId = sourceRow.find('input[name$=".ProductItemId"]').val() || '';
            var recipeId = sourceRow.find('input[name$=".RecipeId"]').val() || '';
            var w = sourceRow.find('input[name$=".WidthMm"]').val() || '';
            var h = sourceRow.find('input[name$=".HeightMm"]').val() || '';
            var qty = sourceRow.find('input[name$=".Quantity"]').val() || 1;
            var price = sourceRow.find('input[name$=".UnitPrice"]').val() || '';
            var pozNo = sourceRow.find('input[name$=".PozNo"]').val() || '';
            var notes = sourceRow.find('input[name$=".Notes"]').val() || '';
            var row = buildLineRow(lineIndex, productId, recipeId, w, h, qty, price, pozNo, notes);
            $('#linesBody').append(row);
            var $newRow = $('#linesBody tr.line-row:last');
            if (productVal) $newRow.find('.item-select').val(productVal);
            calcLineTotal($newRow);
            lineIndex++;
        }

        // Müşteri seçilince direkt taslak sipariş oluştur ve Edit sayfasına yönlendir
        $('[name="CustomerId"]').on('change', function() {
            var customerId = parseInt($(this).val()) || 0;
            if (customerId <= 0) return;
            doQuickCreate(customerId);
        });

        function doQuickCreate(customerId) {
            var data = {
                customerId: customerId,
                orderDate: $('[name="OrderDate"]').val(),
                deliveryDate: $('[name="DeliveryDate"]').val() || null,
                currency: $('[name="Currency"]').val(),
                taxRate: parseInt($('[name="TaxRate"]').val()) || 0,
                notes: $('[name="Notes"]').val() || null,
                lines: []
            };

            // Mevcut kalemler varsa onları da gönder
            $('#linesBody tr.line-row').each(function() {
                var $row = $(this);
                var pid = $row.find('input[name$=".ProductItemId"]').val();
                var rid = $row.find('input[name$=".RecipeId"]').val();
                var lineData = {
                    productItemId: pid ? parseInt(pid) : null,
                    recipeId: rid ? parseInt(rid) : null,
                    pozNo: $row.find('input[name$=".PozNo"]').val() || null,
                    widthMm: $row.find('input[name$=".WidthMm"]').val() ? parseFloat($row.find('input[name$=".WidthMm"]').val()) : null,
                    heightMm: $row.find('input[name$=".HeightMm"]').val() ? parseFloat($row.find('input[name$=".HeightMm"]').val()) : null,
                    quantity: parseInt($row.find('input[name$=".Quantity"]').val()) || 1,
                    unitPrice: parseFloat($row.find('input[name$=".UnitPrice"]').val()) || 0,
                    notes: $row.find('input[name$=".Notes"]').val() || null,
                    features: []
                };
                var featureRow = $row.next('.feature-row');
                if (featureRow.length) {
                    featureRow.find('.feature-entry').each(function() {
                        var defId = $(this).find('.feature-def-id').val();
                        if (defId) {
                            lineData.features.push({
                                featureDefinitionId: parseInt(defId),
                                quantity: parseInt($(this).find('.feature-qty').val()) || 1,
                                unitPrice: parseFloat($(this).find('.feature-unit-price').val()) || 0
                            });
                        }
                    });
                }
                data.lines.push(lineData);
            });

            toastr.info('Sipariş oluşturuluyor...', '', { timeOut: 2000, positionClass: 'toast-bottom-right' });
            $.ajax({
                url: '@Url.Action("QuickCreate")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                success: function(res) {
                    if (res.success) {
                        toastr.success('Sipariş oluşturuldu: ' + res.orderNumber, '', { timeOut: 1500 });
                        window.location.href = '@Url.Action("Edit")/' + res.id;
                    } else {
                        toastr.error(res.error || 'Sipariş oluşturulamadı.');
                    }
                },
                error: function() {
                    toastr.error('Sipariş oluşturulurken hata oluştu.');
                }
            });
        }

        // Manuel Kaydet butonu → onayla, sonra submit et
        $('#btnOrderSave').on('click', function() {
            var custId = parseInt($('[name="CustomerId"]').val()) || 0;
            if (custId <= 0) {
                toastr.warning('Lütfen önce müşteri seçin.');
                return;
            }
            Swal.fire({
                title: 'Sipariş kaydedilsin mi?',
                text: 'Girilen bilgilerle sipariş oluşturulacak. Devam edilsin mi?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Evet, kaydet',
                cancelButtonText: 'Vazgeç',
                confirmButtonColor: '#007bff'
            }).then(function(r) {
                if (r.isConfirmed) $('#orderForm').submit();
            });
        });
    });
    </script>
}
