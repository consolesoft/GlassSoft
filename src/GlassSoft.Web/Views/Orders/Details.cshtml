@model GlassSoft.Application.DTOs.Sales.OrderDto
@{
    ViewData["Title"] = $"Sipariş - {Model.OrderNumber}";
    ViewData["Breadcrumb"] = "Satış";
}

@if (TempData["Success"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function() { toastr.success('@TempData["Success"]'); });</script>
}

<div class="row">
    <div class="col-md-8">
        <!-- Sipariş Bilgileri -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-shopping-cart mr-2"></i>@Model.OrderNumber</h3>
                <div class="card-tools">
                    <span class="badge @Model.StatusBadgeClass" style="font-size: 0.9rem;">@Model.StatusDisplay</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Müşteri:</strong></div>
                    <div class="col-md-3">@Model.CustomerTitle</div>
                    <div class="col-md-3"><strong>Sipariş Tarihi:</strong></div>
                    <div class="col-md-3">@Model.OrderDate.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Termin Tarihi:</strong></div>
                    <div class="col-md-3">@(Model.DeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</div>
                    <div class="col-md-3"><strong>Teslim Tarihi:</strong></div>
                    <div class="col-md-3">@(Model.CompletedAt?.ToString("dd.MM.yyyy") ?? "-")</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Para Birimi:</strong></div>
                    <div class="col-md-3"><span class="badge badge-info">@Model.Currency</span></div>
                    @if (!string.IsNullOrEmpty(Model.OrderCustomerName))
                    {
                        <div class="col-md-3"><strong>Sipariş Müşterisi:</strong></div>
                        <div class="col-md-3">@Model.OrderCustomerName</div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="row mt-2">
                        <div class="col-md-3"><strong>Notlar:</strong></div>
                        <div class="col-md-9">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>

        <!-- Sipariş Kalemleri -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-list mr-2"></i>Sipariş Kalemleri (@Model.Lines.Count)</h3>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                <table class="table table-bordered table-striped table-sm mb-0" style="white-space:nowrap;">
                    <thead>
                        <tr>
                            <th style="width:30px;">
                                @if (Model.Status != GlassSoft.Domain.Enums.OrderStatus.Taslak)
                                {
                                    <input type="checkbox" id="checkAll" title="Tümünü seç" />
                                }
                                else
                                {
                                    <text>#</text>
                                }
                            </th>
                            <th>Ürün/Reçete</th>
                            <th>En</th>
                            <th>Boy</th>
                            <th>Adet</th>
                            <th>Satır m²</th>
                            <th>Birim</th>
                            <th>Toplam</th>
                            <th style="white-space:normal;min-width:140px;">Not</th>
                            <th>Kesim</th>
                            <th>Etiket</th>
                            <th>Poz</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var lineNo = 0; }
                        @foreach (var line in Model.Lines)
                        {
                            lineNo++;
                            <tr>
                                <td>
                                    @if (Model.Status != GlassSoft.Domain.Enums.OrderStatus.Taslak)
                                    {
                                        <input type="checkbox" class="line-check" value="@line.Id" />
                                    }
                                    else
                                    {
                                        @lineNo
                                    }
                                </td>
                                <td>
                                    @if (line.RecipeCode != null)
                                    {
                                        <span class="badge badge-warning"><i class="fas fa-layer-group mr-1"></i>@line.RecipeCode</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-primary">@line.ProductItemName</span>
                                    }
                                </td>
                                <td class="text-right">@(line.IsRetail ? "-" : line.WidthMm?.ToString("0"))</td>
                                <td class="text-right">@(line.IsRetail ? "-" : line.HeightMm?.ToString("0"))</td>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-right">@(line.IsRetail ? "-" : line.TotalAreaM2.ToString("N4"))</td>
                                <td class="text-right">@line.UnitPrice.ToString("N2")</td>
                                <td class="text-right"><strong>@line.TotalPrice.ToString("N2")</strong></td>
                                <td class="small">@(line.Notes ?? "-")</td>
                                <td class="text-center">
                                    @if (line.IsOptimized)
                                    {
                                        <span class="badge badge-success"><i class="fas fa-check"></i></span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary"><i class="fas fa-clock"></i></span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (line.IsLabelPrinted)
                                    {
                                        <span class="badge badge-success" title="@line.LabelPrintedAt?.ToString("dd.MM.yyyy HH:mm")">
                                            <i class="fas fa-tag"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light text-muted"><i class="fas fa-tag"></i></span>
                                    }
                                </td>
                                <td>@(line.PozNo ?? "-")</td>
                            </tr>
                            @if (line.Features.Any())
                            {
                                <tr class="bg-light">
                                    <td></td>
                                    <td colspan="11">
                                        <small class="text-muted"><i class="fas fa-tags mr-1"></i>Özellikler:</small>
                                        @foreach (var f in line.Features)
                                        {
                                            <span class="badge badge-info ml-1">@f.FeatureName x@(f.Quantity) = @f.TotalPrice.ToString("N2")</span>
                                        }
                                        <span class="badge badge-primary ml-2">Özellik Toplamı: @line.FeaturesTotalPrice.ToString("N2")</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4" class="text-right">Toplam:</th>
                            <th class="text-center">@Model.Lines.Sum(l => l.Quantity)</th>
                            <th class="text-right">@Model.Lines.Sum(l => l.TotalAreaM2).ToString("N2") m²</th>
                            <th></th>
                            <th class="text-right"><strong>@Model.TotalAmount.ToString("N2") @Model.Currency</strong></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
                </div>
            </div>
        </div>

        <!-- Sipariş Hareket Geçmişi (Timeline) -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-history mr-2"></i>Sipariş Hareket Geçmişi</h3>
            </div>
            <div class="card-body">
                @{
                    // Tüm hareketleri kronolojik sırayla topla
                    var events = new List<(DateTime Date, string Icon, string Color, string Title, string Body)>();

                    events.Add((Model.CreatedAt, "fas fa-plus", "bg-primary", "Sipariş Oluşturuldu",
                        $"Sipariş No: <strong>{Model.OrderNumber}</strong> — Müşteri: <strong>{Model.CustomerTitle}</strong> — Kalem: <strong>{Model.Lines.Count}</strong>"));

                    if (Model.ApprovedAt.HasValue)
                    {
                        events.Add((Model.ApprovedAt.Value, "fas fa-check", "bg-info", "Onaylandı",
                            $"Müşteriye borç kaydı oluşturuldu: <strong>{Model.GrandTotal.ToString("N2")} {Model.Currency}</strong>"));
                    }

                    if (Model.ProductionStartedAt.HasValue)
                    {
                        events.Add((Model.ProductionStartedAt.Value, "fas fa-cogs", "bg-warning", "Üretime Alındı",
                            "Stok çıkışı yapıldı, iş emri oluşturulabilir."));
                    }

                    if (Model.DeliveryDate.HasValue)
                    {
                        var deliveryStatus = Model.DeliveryDate.Value.Date < DateTime.Now.Date && Model.Status != GlassSoft.Domain.Enums.OrderStatus.Tamamlandi
                            ? "<span class=\"badge badge-danger ml-1\">Gecikmiş</span>"
                            : "";
                        events.Add((Model.DeliveryDate.Value, "fas fa-truck", "bg-secondary", "Termin Tarihi",
                            $"Planlanan teslim tarihi {deliveryStatus}"));
                    }

                    if (Model.CompletedAt.HasValue)
                    {
                        events.Add((Model.CompletedAt.Value, "fas fa-flag-checkered", "bg-success", "Tamamlandı",
                            "Sipariş teslim edildi ve tamamlandı."));
                    }

                    if (Model.CancelledAt.HasValue)
                    {
                        events.Add((Model.CancelledAt.Value, "fas fa-times", "bg-danger", "İptal Edildi",
                            "Sipariş iptal edildi, cari borç silindi ve stok iade edildi."));
                    }

                    events = events.OrderBy(e => e.Date).ToList();
                    string? currentLabel = null;
                }

                <div class="timeline timeline-inverse">
                    @foreach (var ev in events)
                    {
                        var dayLabel = ev.Date.ToString("dd.MM.yyyy");
                        if (dayLabel != currentLabel)
                        {
                            <div class="time-label"><span class="bg-dark">@dayLabel</span></div>
                            currentLabel = dayLabel;
                        }
                        <div>
                            <i class="@ev.Icon @ev.Color"></i>
                            <div class="timeline-item">
                                <span class="time"><i class="far fa-clock"></i> @ev.Date.ToString("HH:mm")</span>
                                <h3 class="timeline-header border-0"><strong>@ev.Title</strong></h3>
                                <div class="timeline-body">@Html.Raw(ev.Body)</div>
                            </div>
                        </div>
                    }
                    <div>
                        <i class="far fa-clock bg-gray"></i>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-controller="Transactions" asp-action="Index" asp-route-customerId="@Model.CustomerId" asp-route-orderNumber="@Model.OrderNumber" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-exchange-alt mr-1"></i> İlgili Cari Hareketler
                    </a>
                    <a asp-controller="Deliveries" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-outline-success btn-sm ml-1">
                        <i class="fas fa-truck mr-1"></i> Yeni Teslimat
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Durum Yönetimi -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-tasks mr-2"></i>Durum Yönetimi</h3>
            </div>
            <div class="card-body">
                @if (Model.Status == GlassSoft.Domain.Enums.OrderStatus.Taslak)
                {
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@((int)GlassSoft.Domain.Enums.OrderStatus.Onaylandi)" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-block mb-2">
                            <i class="fas fa-check mr-1"></i> Onayla
                        </button>
                    </form>
                }
                @if (Model.Status == GlassSoft.Domain.Enums.OrderStatus.Onaylandi)
                {
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@((int)GlassSoft.Domain.Enums.OrderStatus.Uretimde)" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-block mb-2">
                            <i class="fas fa-industry mr-1"></i> Üretime Al
                        </button>
                    </form>
                    <form asp-action="UpdateStatus" method="post" onsubmit="return confirm('Onayı geri almak istediğinize emin misiniz? Cariye yansıyan borç hareketi silinecek ve düşülen stoklar geri iade edilecek. Sipariş Taslak durumuna alınacak.');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@((int)GlassSoft.Domain.Enums.OrderStatus.Taslak)" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary btn-block mb-2">
                            <i class="fas fa-undo mr-1"></i> Onayı Geri Al
                        </button>
                    </form>
                }
                @{
                    var openLineCount = (int)(ViewBag.OpenLineCount ?? 0);
                    var openRemainingTotal = (int)(ViewBag.OpenRemainingTotal ?? 0);
                    var hasOpen = (bool)(ViewBag.HasOpenLines ?? false);
                    // Düzenleme sonrası Tamamlandı durumda olup hala açık kalemi olan siparişler için uyarı
                    var showCompleteForOpenAfterEdit = Model.Status == GlassSoft.Domain.Enums.OrderStatus.Tamamlandi && hasOpen;
                }
                @if (Model.Status == GlassSoft.Domain.Enums.OrderStatus.Uretimde
                     || showCompleteForOpenAfterEdit)
                {
                    if (showCompleteForOpenAfterEdit)
                    {
                        <div class="alert alert-warning small p-2 mb-2">
                            <i class="fas fa-exclamation-triangle mr-1"></i>
                            Düzenleme sonrası <strong>@openLineCount kalemde @openRemainingTotal adet</strong> teslim edilmemiş kaldı.
                        </div>
                    }
                    else if (hasOpen)
                    {
                        <div class="alert alert-info small p-2 mb-2">
                            <i class="fas fa-info-circle mr-1"></i>
                            Açık: <strong>@openLineCount kalem / @openRemainingTotal adet</strong>
                        </div>
                    }
                    <form asp-action="UpdateStatus" method="post" id="completeForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@((int)GlassSoft.Domain.Enums.OrderStatus.Tamamlandi)" />
                        <input type="hidden" name="completedAt" id="completedAtInput" />
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-success btn-block mb-2" id="btnCompleteOrder">
                            <i class="fas fa-check-double mr-1"></i>
                            @(showCompleteForOpenAfterEdit ? "Kalanları Teslim Et & Tamamla" : "Tamamla")
                        </button>
                    </form>
                }
                @if (Model.Status != GlassSoft.Domain.Enums.OrderStatus.IptalEdildi && Model.Status != GlassSoft.Domain.Enums.OrderStatus.Tamamlandi)
                {
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="status" value="@((int)GlassSoft.Domain.Enums.OrderStatus.IptalEdildi)" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-block mb-2 btn-delete">
                            <i class="fas fa-times mr-1"></i> İptal Et
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Özet -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-calculator mr-2"></i>Özet</h3>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Toplam Kalem:</span>
                    <strong>@Model.Lines.Count</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Toplam Adet:</span>
                    <strong>@Model.Lines.Sum(l => l.Quantity)</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Toplam m²:</span>
                    <strong>@Model.Lines.Sum(l => l.TotalAreaM2).ToString("N2")</strong>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span>Ara Toplam:</span>
                    <strong>@Model.TotalAmount.ToString("N2") @Model.Currency</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>KDV (%@Model.TaxRate):</span>
                    <strong>@Model.TaxAmount.ToString("N2") @Model.Currency</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="h5">Genel Toplam:</span>
                    <strong class="h5 text-primary">@Model.GrandTotal.ToString("N2") @Model.Currency</strong>
                </div>
            </div>
        </div>

        <!-- Yazdır -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-print mr-2"></i>Yazdır</h3>
            </div>
            <div class="card-body">
                <button class="btn btn-info btn-block mb-2" onclick="openPrintModal(@((int)GlassSoft.Domain.Enums.OutputType.Siparis), @Model.Id)">
                    <i class="fas fa-file-invoice mr-1"></i> Sipariş Fişi
                </button>
                <button class="btn btn-info btn-block mb-2" onclick="openPrintModal(@((int)GlassSoft.Domain.Enums.OutputType.FiyatsizSiparis), @Model.Id)">
                    <i class="fas fa-file-alt mr-1"></i> Fiyatsız Sipariş
                </button>
                <button class="btn btn-info btn-block mb-2" onclick="openPrintModal(@((int)GlassSoft.Domain.Enums.OutputType.Teslimat), @Model.Id)">
                    <i class="fas fa-truck mr-1"></i> Teslimat İrsaliyesi
                </button>
                <button class="btn btn-info btn-block mb-2" onclick="openPrintModal(@((int)GlassSoft.Domain.Enums.OutputType.CitaRaporu), @Model.Id)">
                    <i class="fas fa-bars mr-1"></i> Çıta Raporu
                </button>
                @if (Model.Status != GlassSoft.Domain.Enums.OrderStatus.Taslak)
                {
                    <hr>
                    <button class="btn btn-danger btn-block" id="btnLabelPrint">
                        <i class="fas fa-tag mr-1"></i> Etiket Yazdır
                    </button>
                    <small class="text-muted d-block mt-1 text-center">Tablodan kalemleri seçip yazdırın</small>
                }
            </div>
        </div>

        @if (Model.Status == GlassSoft.Domain.Enums.OrderStatus.Taslak || Model.Status == GlassSoft.Domain.Enums.OrderStatus.Tamamlandi)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-block"><i class="fas fa-edit mr-1"></i> Düzenle</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="orderDeleteForm">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-danger btn-block" id="btnOrderDelete"><i class="fas fa-trash mr-1"></i> Siparişi Sil</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary btn-block"><i class="fas fa-arrow-left mr-1"></i> Listeye Dön</a>
    </div>
</div>

@await Html.PartialAsync("_PrintModal")

<!-- Etiket Yazdır Modal -->
<div class="modal fade" id="labelPrintModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger">
                <h5 class="modal-title"><i class="fas fa-tag mr-2"></i>Etiket Yazdır</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label><i class="fas fa-palette mr-1"></i> Etiket Şablonu</label>
                    <select class="form-control no-select2" id="labelTemplateSelect">
                        <option value="">Yükleniyor...</option>
                    </select>
                </div>
                <div id="labelSelectedInfo" class="alert alert-info">
                    <i class="fas fa-info-circle mr-1"></i> <span id="labelSelectedCount">0</span> kalem seçildi
                </div>
                <div class="custom-control custom-checkbox mt-2">
                    <input type="checkbox" class="custom-control-input" id="markAsPrinted" checked>
                    <label class="custom-control-label" for="markAsPrinted">Yazdırıldı olarak işaretle</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-info" id="btnLabelPreview">
                    <i class="fas fa-eye mr-1"></i> Önizle
                </button>
                <button type="button" class="btn btn-danger" id="btnLabelDoPrint">
                    <i class="fas fa-print mr-1"></i> Yazdır
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    // Sipariş tamamlama — teslim tarihi sor + otomatik tam teslimat oluşturulur
    $('#btnCompleteOrder').on('click', function() {
        var today = new Date().toISOString().slice(0,10);
        Swal.fire({
            title: 'Siparişi Tamamla',
            html: '<div class="text-left">' +
                  '<p>Bu siparişin <strong>tüm açık kalemleri</strong> için otomatik bir <strong>onaylı teslimat formu</strong> oluşturulacak.</p>' +
                  '<p class="mb-2">Teslim tarihini seçin:</p>' +
                  '<small class="text-muted">Bu tarih Ürün Satış Raporunda kullanılacak.</small>' +
                  '</div>',
            input: 'date',
            inputValue: today,
            showCancelButton: true,
            confirmButtonText: '<i class="fas fa-check mr-1"></i> Evet, Tamamla',
            cancelButtonText: 'Vazgeç',
            confirmButtonColor: '#28a745',
            inputValidator: function(value) {
                if (!value) return 'Lütfen teslim tarihi seçin.';
            }
        }).then(function(r) {
            if (r.isConfirmed) {
                $('#completedAtInput').val(r.value);
                $('#completeForm').submit();
            }
        });
    });

    // Sipariş silme
    $('#btnOrderDelete').on('click', function() {
        Swal.fire({
            title: 'Siparişi sil?',
            html: '<b>@Model.OrderNumber</b> numaralı siparişi silmek istediğinize emin misiniz?<br><small class="text-danger">Bu işlem geri alınamaz.</small>',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'Vazgeç',
            confirmButtonColor: '#dc3545'
        }).then(function(r) {
            if (r.isConfirmed) $('#orderDeleteForm').submit();
        });
    });

    // Tümünü seç checkbox
    $('#checkAll').on('change', function() {
        $('.line-check').prop('checked', this.checked);
    });

    // Etiket yazdır butonu
    $('#btnLabelPrint').on('click', function() {
        var selected = $('.line-check:checked');
        if (selected.length === 0) {
            toastr.warning('Lütfen en az bir kalem seçin.');
            return;
        }
        $('#labelSelectedCount').text(selected.length);

        // Şablonları yükle
        $.get('@Url.Action("GetTemplates", "Output")', { type: 7 }, function(data) {
            var sel = $('#labelTemplateSelect');
            sel.empty();
            if (data.length === 0) {
                sel.append('<option value="">Etiket şablonu bulunamadı</option>');
            } else {
                data.forEach(function(t) {
                    sel.append('<option value="' + t.id + '"' + (t.isDefault ? ' selected' : '') + '>' + t.name + '</option>');
                });
            }
        });
        $('#labelPrintModal').modal('show');
    });

    function getSelectedLineIds() {
        return $('.line-check:checked').map(function() { return parseInt($(this).val()); }).get();
    }

    function buildLabelUrl(autoPrint) {
        var templateId = $('#labelTemplateSelect').val();
        if (!templateId) { toastr.warning('Şablon seçin.'); return null; }
        var lineIds = getSelectedLineIds();
        var params = 'orderId=@Model.Id&templateId=' + templateId;
        lineIds.forEach(function(id) { params += '&lineIds=' + id; });
        if (autoPrint) params += '&autoPrint=true';
        return '@Url.Action("RenderLabel", "Output")?' + params;
    }

    // Önizle
    $('#btnLabelPreview').on('click', function() {
        var url = buildLabelUrl(false);
        if (url) window.open(url, '_blank');
    });

    // Yazdır
    $('#btnLabelDoPrint').on('click', function() {
        var url = buildLabelUrl(true);
        if (!url) return;
        window.open(url, '_blank');

        // İşaretle
        if ($('#markAsPrinted').is(':checked')) {
            var lineIds = getSelectedLineIds();
            $.ajax({
                url: '@Url.Action("MarkLabelsPrinted", "Output")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(lineIds),
                success: function() {
                    toastr.success('Etiketler yazdırıldı olarak işaretlendi.');
                    setTimeout(function() { location.reload(); }, 1500);
                }
            });
        }
        $('#labelPrintModal').modal('hide');
    });
});
</script>
}
