@model GlassSoft.Application.DTOs.Sales.DeliveryUpdateDto
@{
    ViewData["Title"] = "Teslimat Düzenle";
    ViewData["Breadcrumb"] = "Satış";
    var openLines = ViewBag.OpenLines as List<GlassSoft.Application.DTOs.Sales.OpenOrderLineDto> ?? new();
    var delivery = ViewBag.Delivery as GlassSoft.Application.DTOs.Sales.DeliveryDto;

    // Mevcut teslimat satırlarındaki OrderLineId'leri set olarak al
    var existingLines = Model.Lines.ToDictionary(l => l.OrderLineId, l => l.Quantity);

    // Hem açık satırlar hem de bu teslimatta zaten olanları göster
    // Mevcut satırlar excludeDelivery sayesinde "açık" listesinde de görünür (max = açık + bu teslimattaki miktar)
}

<form asp-action="Edit" method="post" id="deliveryForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-edit mr-2"></i>Teslimat Düzenle:
                <strong>@delivery?.DeliveryNumber</strong>
                <span class="badge @delivery?.StatusBadgeClass ml-2">@delivery?.StatusDisplay</span>
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label>Sipariş</label>
                    <input type="text" class="form-control" value="@delivery?.OrderNumber - @delivery?.CustomerTitle" readonly />
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label asp-for="DeliveryDate">Teslim Tarihi</label>
                        <input asp-for="DeliveryDate" type="date" class="form-control" value="@Model.DeliveryDate.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Notes">Açıklama / Notlar</label>
                <textarea asp-for="Notes" class="form-control" rows="2">@Model.Notes</textarea>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list mr-2"></i>Teslim Edilen Kalemler</h3>
        </div>
        <div class="card-body">
            @if (openLines.Any())
            {
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width:40px"></th>
                            <th>Poz</th>
                            <th>Ürün / Reçete</th>
                            <th class="text-right">En × Boy</th>
                            <th class="text-right">Sipariş</th>
                            <th class="text-right">Diğer Teslim</th>
                            <th class="text-right">Maks (Kalan + Bu)</th>
                            <th style="width:120px" class="text-center">Bu Teslimat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 0;
                        }
                        @foreach (var l in openLines)
                        {
                            var existingQty = existingLines.TryGetValue(l.OrderLineId, out var q) ? q : 0;
                            var maxAllowed = l.RemainingQuantity; // excludeDelivery zaten bunu hesapladı
                            var isChecked = existingQty > 0;
                            <tr class="line-row" data-line-id="@l.OrderLineId" data-max="@maxAllowed">
                                <td class="text-center">
                                    <input type="checkbox" class="line-check" @(isChecked ? "checked" : "") />
                                </td>
                                <td>@(l.PozNo ?? "-")</td>
                                <td>@l.ProductName</td>
                                <td class="text-right">
                                    @if (l.IsRetail)
                                    {
                                        <span class="text-muted">Perakende</span>
                                    }
                                    else
                                    {
                                        @($"{l.WidthMm}×{l.HeightMm}")
                                    }
                                </td>
                                <td class="text-right">@l.OrderQuantity</td>
                                <td class="text-right">@(l.DeliveredQuantity)</td>
                                <td class="text-right"><strong>@maxAllowed</strong></td>
                                <td>
                                    <input type="hidden" name="Lines[@i].OrderLineId" value="@l.OrderLineId" />
                                    <input type="number" name="Lines[@i].Quantity" min="0" max="@maxAllowed"
                                           value="@existingQty"
                                           class="form-control form-control-sm text-right line-qty"
                                           @(isChecked ? "" : "disabled") />
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning">Düzenlenebilir kalem yok.</div>
            }
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Güncelle</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light ml-2"><i class="fas fa-arrow-left mr-1"></i> Geri</a>
        </div>
    </div>
</form>

@section Scripts {
    <script>
    $(function() {
        $(document).on('change', '.line-check', function() {
            var $row = $(this).closest('tr');
            var $qty = $row.find('.line-qty');
            var max = parseInt($row.data('max')) || 0;
            if ($(this).is(':checked')) {
                $qty.prop('disabled', false);
                if ((parseInt($qty.val()) || 0) === 0) $qty.val(max);
            } else {
                $qty.prop('disabled', true).val(0);
            }
        });

        $(document).on('input', '.line-qty', function() {
            var max = parseInt($(this).attr('max')) || 0;
            var v = parseInt($(this).val()) || 0;
            if (v > max) {
                $(this).val(max);
                Swal.fire({ icon: 'warning', title: 'Sınır aşıldı', text: 'En fazla ' + max + ' adet teslim edilebilir.' });
            }
            if (v < 0) $(this).val(0);
        });

        $('#deliveryForm').on('submit', function(e) {
            var hasLine = false;
            $('.line-qty').each(function() {
                if ((parseInt($(this).val()) || 0) > 0) { hasLine = true; return false; }
            });
            if (!hasLine) {
                e.preventDefault();
                Swal.fire({ icon: 'warning', title: 'Kalem yok', text: 'En az bir kalem ve miktar girilmelidir.' });
                return false;
            }
        });
    });
    </script>
}
