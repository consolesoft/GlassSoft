@model IEnumerable<GlassSoft.Domain.Entities.Sales.OrderFeatureDefinition>
@{
    ViewData["Title"] = "Sipariş Kalem Özellikleri";
    ViewData["Breadcrumb"] = "Satış";
}

@if (TempData["Success"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function() { toastr.success('@TempData["Success"]'); });</script>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-tags mr-2"></i>Kalem Özellikleri (Parametre Tanımları)</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus mr-1"></i> Yeni Özellik
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="tblFeatures" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Özellik Adı</th>
                    <th>Birim Fiyat</th>
                    <th>Açıklama</th>
                    <th>Durum</th>
                    <th style="width: 120px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td class="text-right">@item.UnitPrice.ToString("N2")</td>
                        <td>@(item.Description ?? "-")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-xs" title="Düzenle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-xs btn-delete" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$(document).ready(function() { $('#tblFeatures').DataTable({ "order": [[0, "desc"]] }); });</script>
}
