@model GlassSoft.Application.DTOs.Accounting.CashRegisterCreateDto
@{
    ViewData["Title"] = "Yeni Kasa";
    ViewData["Breadcrumb"] = "Ön Muhasebe";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-plus mr-2"></i>Yeni Kasa Oluştur</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="Name">Kasa Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: Ana Kasa, Döviz Kasası" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Currency">Para Birimi <span class="text-danger">*</span></label>
                                <select asp-for="Currency" class="form-control">
                                    <option value="TRY">TRY - Türk Lirası</option>
                                    <option value="USD">USD - Amerikan Doları</option>
                                    <option value="EUR">EUR - Euro</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="OpeningBalance">Açılış Bakiyesi</label>
                                <input asp-for="OpeningBalance" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Opsiyonel"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary ml-2"><i class="fas fa-arrow-left mr-1"></i> Geri</a>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>Bilgi</h3>
            </div>
            <div class="card-body">
                <p class="small text-muted"><strong>Kasa Adı:</strong> Her kasa için benzersiz, tanımlayıcı bir isim verin.</p>
                <hr>
                <p class="small text-muted"><strong>Para Birimi:</strong> Kasanın hangi para birimiyle çalışacağını belirleyin. Her para birimi için ayrı kasa açabilirsiniz.</p>
                <hr>
                <p class="small text-muted"><strong>Açılış Bakiyesi:</strong> Kasanın başlangıç bakiyesini girin. Sonraki işlemlerle bakiye otomatik güncellenecektir.</p>
            </div>
        </div>
    </div>
</div>
