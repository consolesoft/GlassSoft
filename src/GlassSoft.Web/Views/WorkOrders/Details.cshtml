@model GlassSoft.Application.DTOs.Production.WorkOrderDto
@{
    ViewData["Title"] = $"İş Emri - {Model.WorkOrderNumber}";
    ViewData["Breadcrumb"] = "Üretim & Kesim";
}

@if (TempData["Success"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function() { toastr.success('@TempData["Success"]'); });</script>
}

<div class="row">
    <div class="col-md-8">
        <!-- İş Emri Bilgileri -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-industry mr-2"></i>@Model.WorkOrderNumber</h3>
                <div class="card-tools">
                    @if (Model.IsCompleted)
                    {
                        <span class="badge badge-success" style="font-size: 0.9rem;"><i class="fas fa-check mr-1"></i>Tamamlandı</span>
                    }
                    else
                    {
                        <span class="badge badge-warning" style="font-size: 0.9rem;"><i class="fas fa-clock mr-1"></i>Devam Ediyor</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Siparişler:</strong></div>
                    <div class="col-md-9">
                        @if (Model.RelatedOrders.Any())
                        {
                            @foreach (var ro in Model.RelatedOrders)
                            {
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@ro.OrderId"
                                   class="badge badge-info mr-1" style="font-size: 0.85rem;">@ro.OrderNumber</a>
                                <small class="text-muted mr-3">@ro.CustomerTitle</small>
                            }
                        }
                        else if (Model.OrderId > 0)
                        {
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderNumber</a>
                            <small class="text-muted ml-2">@Model.CustomerTitle</small>
                        }
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Planlanan Tarih:</strong></div>
                    <div class="col-md-3">@Model.PlannedDate.ToString("dd.MM.yyyy")</div>
                    <div class="col-md-3"><strong>Tamamlanma:</strong></div>
                    <div class="col-md-3">@(Model.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>
            </div>
        </div>

        <!-- Malzeme Listesi -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-list mr-2"></i>Malzeme Listesi (@Model.Lines.Count)</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Malzeme</th>
                            <th>Tip</th>
                            <th>En (mm)</th>
                            <th>Boy (mm)</th>
                            <th>m²</th>
                            <th>Adet</th>
                            <th>Kesim</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.ProductItemName</td>
                                <td>
                                    @if (line.MaterialType == "Glass")
                                    {
                                        <span class="badge badge-info">Cam</span>
                                    }
                                    else if (line.MaterialType == "Spacer")
                                    {
                                        <span class="badge badge-warning">Ara Parça</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Sarf</span>
                                    }
                                </td>
                                <td class="text-right">@(line.WidthMm > 0 ? line.WidthMm.ToString("0") : "-")</td>
                                <td class="text-right">@(line.HeightMm > 0 ? line.HeightMm.ToString("0") : "-")</td>
                                <td class="text-right">@(line.AreaM2 > 0 ? line.AreaM2.ToString("N4") : "-")</td>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-center">
                                    @if (line.MaterialType == "Glass")
                                    {
                                        if (line.IsOptimized)
                                        {
                                            <span class="badge badge-success"><i class="fas fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary"><i class="fas fa-clock"></i></span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Kesim Planları -->
        @if (Model.CuttingPlans.Any())
        {
            @foreach (var plan in Model.CuttingPlans)
            {
                <div class="card cutting-editor-card" data-plan-id="@plan.Id">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-cut mr-2"></i>Kesim Planı #@plan.PlateIndex - @plan.ProductItemName
                            <small class="ml-2 text-muted">(@plan.PlateDisplayName mm)</small>
                            @if (plan.IsApproved)
                            {
                                <span class="badge badge-success ml-2"><i class="fas fa-check mr-1"></i>Onaylı</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary ml-2"><i class="fas fa-magic mr-1"></i>Otomatik</span>
                            }
                        </h3>
                        <div class="card-tools">
                            <span class="badge badge-info mr-2 waste-badge">Fire: %@plan.WastePercentage.ToString("N1")</span>
                            <a asp-action="DownloadCsv" asp-route-id="@Model.Id" asp-route-planId="@plan.Id" class="btn btn-success btn-xs">
                                <i class="fas fa-file-csv mr-1"></i>CSV
                            </a>
                            <a asp-action="DownloadDxf" asp-route-id="@Model.Id" asp-route-planId="@plan.Id" class="btn btn-primary btn-xs ml-1">
                                <i class="fas fa-file-alt mr-1"></i>DXF
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @{
                            var ic = System.Globalization.CultureInfo.InvariantCulture;
                            var svgScale = 0.15;
                            var svgW = ((double)plan.PlateWidthMm * svgScale).ToString(ic);
                            var svgH = ((double)plan.PlateHeightMm * svgScale).ToString(ic);
                            var plateW = ((double)plan.PlateWidthMm).ToString(ic);
                            var plateH = ((double)plan.PlateHeightMm).ToString(ic);
                            var colors = new[] { "#17a2b8", "#28a745", "#ffc107", "#dc3545", "#6f42c1", "#fd7e14", "#20c997", "#e83e8c" };
                        }
                        <div class="cutting-toolbar">
                            <div class="btn-group btn-group-sm">
                                @if (!Model.IsCompleted)
                                {
                                    <button type="button" class="btn btn-primary btn-save-plan" disabled>
                                        <i class="fas fa-save mr-1"></i> Değişiklikleri Kaydet
                                    </button>
                                    <button type="button" class="btn btn-secondary btn-reset-plan">
                                        <i class="fas fa-undo mr-1"></i> Sıfırla
                                    </button>
                                    <button type="button" class="btn btn-info btn-rotate-piece" disabled>
                                        <i class="fas fa-sync-alt mr-1"></i> Döndür
                                    </button>
                                }
                            </div>
                            <div class="cutting-status">
                                <span class="piece-info text-muted"><i class="fas fa-mouse-pointer mr-1"></i>Cam seçilmedi</span>
                            </div>
                        </div>
                        <div class="cutting-canvas-wrapper">
                            <svg class="cutting-svg" width="@svgW" height="@svgH" viewBox="0 0 @plateW @plateH"
                                 data-plate-width="@plateW" data-plate-height="@plateH" data-plan-id="@plan.Id"
                                 style="max-width: 100%; user-select: none;">
                                <defs>
                                    <pattern id="gridPattern" width="50" height="50" patternUnits="userSpaceOnUse">
                                        <path d="M 50 0 L 0 0 0 50" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="0.5"/>
                                    </pattern>
                                </defs>
                                <!-- Plaka arka planı -->
                                <rect x="0" y="0" width="@plateW" height="@plateH" fill="url(#gridPattern)" />
                                <!-- Plaka çerçevesi -->
                                <rect x="0" y="0" width="@plateW" height="@plateH" class="plate-frame" />
                                <!-- Parçalar -->
                                @{ var idx = 0; }
                                @foreach (var item in plan.Items)
                                {
                                    var color = colors[idx % colors.Length];
                                    var ix = ((double)item.X).ToString(ic);
                                    var iy = ((double)item.Y).ToString(ic);
                                    var iw = ((double)item.WidthMm).ToString(ic);
                                    var ih = ((double)item.HeightMm).ToString(ic);
                                    var tx = ((double)(item.X + item.WidthMm / 2)).ToString(ic);
                                    var ty = ((double)(item.Y + item.HeightMm / 2)).ToString(ic);
                                var labelText = $"{item.WidthMm.ToString("0")}x{item.HeightMm.ToString("0")}";
                                var neededWidth = labelText.Length * 0.6;
                                var byWidth = neededWidth > 0 ? (double)item.WidthMm / neededWidth : 100;
                                var byHeight = (double)item.HeightMm / 2.2;
                                var fs = Math.Max(12, Math.Min(Math.Min(byWidth, byHeight), 60)).ToString(ic);
                                    <g class="piece-group" data-id="@item.Id" data-x="@ix" data-y="@iy"
                                       data-width="@iw" data-height="@ih" data-rotation="@(item.IsRotated ? "1" : "0")"
                                       data-color="@color" transform="translate(@ix, @iy)">
                                        <rect x="0" y="0" width="@iw" height="@ih" rx="4" ry="4"
                                              fill="@color" fill-opacity="0.65" stroke="@color" stroke-width="2" class="piece-rect" />
                                        <text x="@((double)item.WidthMm / 2).ToString(ic)" y="@((double)item.HeightMm / 2).ToString(ic)"
                                              text-anchor="middle" dominant-baseline="central" fill="white" font-size="@fs" class="piece-label">@labelText</text>
                                    </g>
                                    idx++;
                                }
                            </svg>
                        </div>
                        <div class="cutting-stats">
                            <div class="row text-center">
                                <div class="col-4 border-right border-secondary">
                                    <div class="text-muted small">Plaka</div>
                                    <strong class="plate-size">@plan.PlateWidthMm.ToString("0") x @plan.PlateHeightMm.ToString("0") mm</strong>
                                </div>
                                <div class="col-4 border-right border-secondary">
                                    <div class="text-muted small">Kullanılan</div>
                                    <strong class="used-area">@plan.UsedAreaM2.ToString("N2") m²</strong>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small">Fire</div>
                                    <strong class="waste-area @(plan.WastePercentage < 20 ? "text-success" : plan.WastePercentage < 35 ? "text-warning" : "text-danger")">
                                        @plan.WasteAreaM2.ToString("N2") m² (%@plan.WastePercentage.ToString("N1"))
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-md-4">
        <!-- Aksiyonlar -->
        @if (!Model.IsCompleted)
        {
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-bolt mr-2"></i>Aksiyonlar</h3>
                </div>
                <div class="card-body">
                    @if (!Model.CuttingPlans.Any())
                    {
                        <button type="button" class="btn btn-warning btn-block mb-2" id="btnRunOptimize">
                            <i class="fas fa-cut mr-1"></i> Kesim Optimizasyonu Çalıştır
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-warning btn-block mb-2" id="btnRunOptimize">
                            <i class="fas fa-redo mr-1"></i> Yeniden Optimize Et
                        </button>
                        <form asp-action="Complete" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-block mb-2">
                                <i class="fas fa-check-double mr-1"></i> Tamamla & Stok Düş
                            </button>
                        </form>
                    }
                </div>
            </div>
        }

        <!-- Özet -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-pie mr-2"></i>Özet</h3>
            </div>
            <div class="card-body">
                @{
                    var glassLines = Model.Lines.Where(l => l.MaterialType == "Glass").ToList();
                    var spacerLines = Model.Lines.Where(l => l.MaterialType == "Spacer").ToList();
                    var consumableLines = Model.Lines.Where(l => l.MaterialType == "Consumable").ToList();
                }
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-info">Cam</span> Malzeme:</span>
                    <strong>@glassLines.Count satır</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-warning">Ara Parça</span>:</span>
                    <strong>@spacerLines.Count satır</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-secondary">Sarf</span> Malzeme:</span>
                    <strong>@consumableLines.Count satır</strong>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span>Kesim Planı:</span>
                    <strong>@Model.CuttingPlans.Count plaka</strong>
                </div>
                @if (Model.CuttingPlans.Any())
                {
                    var totalUsed = Model.CuttingPlans.Sum(p => p.UsedAreaM2);
                    var totalWaste = Model.CuttingPlans.Sum(p => p.WasteAreaM2);
                    var avgWaste = Model.CuttingPlans.Average(p => p.WastePercentage);
                    <div class="d-flex justify-content-between mb-2">
                        <span>Toplam Kullanım:</span>
                        <strong>@totalUsed.ToString("N2") m²</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Toplam Fire:</span>
                        <strong class="text-danger">@totalWaste.ToString("N2") m²</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Ort. Fire Oranı:</span>
                        <strong class="@(avgWaste < 20 ? "text-success" : avgWaste < 35 ? "text-warning" : "text-danger")">
                            %@avgWaste.ToString("N1")
                        </strong>
                    </div>
                }
            </div>
        </div>

        <!-- Yazdır -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-print mr-2"></i>Yazdır</h3>
            </div>
            <div class="card-body">
                <button class="btn btn-info btn-block" onclick="openPrintModal(@((int)GlassSoft.Domain.Enums.OutputType.Uretim), @Model.Id)">
                    <i class="fas fa-file-alt mr-1"></i> Üretim Emri
                </button>
            </div>
        </div>

        @if (!Model.IsCompleted)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="workOrderDeleteForm">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-danger btn-block mb-2" id="btnWorkOrderDelete"><i class="fas fa-trash mr-1"></i> İş Emrini Sil</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary btn-block"><i class="fas fa-arrow-left mr-1"></i> Listeye Dön</a>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var deleteBtn = document.getElementById('btnWorkOrderDelete');
    var deleteForm = document.getElementById('workOrderDeleteForm');
    if (!deleteBtn || !deleteForm) return;

    deleteBtn.addEventListener('click', function(e) {
        e.preventDefault();

        var doSubmit = function() {
            deleteBtn.disabled = true;
            deleteForm.submit();
        };

        // SweetAlert yüklenmemişse basit confirm kullan
        if (typeof Swal === 'undefined') {
            if (confirm('@Model.WorkOrderNumber iş emrini silmek istediğinize emin misiniz?')) {
                doSubmit();
            }
            return;
        }

        Swal.fire({
            title: 'İş emrini sil?',
            html: '<b>@Model.WorkOrderNumber</b> iş emrini silmek istediğinize emin misiniz?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'Vazgeç',
            confirmButtonColor: '#dc3545'
        }).then(function(result) {
            if (result.isConfirmed) doSubmit();
        });
    });
});
</script>

<script>
    // ============================================================
    // Kesim Planı İnteraktif Editör
    // ============================================================
    (function() {
        var tokenValue = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var workOrderId = @Model.Id;
        var isCompleted = @(Model.IsCompleted ? "true" : "false");

        // Her plan için editör durumunu saklar
        var editors = {};

            function formatNumber(num, decimals) {
                var d = decimals == null ? 1 : decimals;
                return Number(num).toFixed(d);
            }

            function fitFontSize(item, text) {
                // mm bazlı: karakter yaklaşık font-size'in 0.6 katı kadar yer kaplar
                var neededWidth = text.length * 0.6;
                var byWidth = neededWidth > 0 ? item.width / neededWidth : 100;
                var byHeight = item.height / 2.2;
                return Math.max(12, Math.min(byWidth, byHeight, 60));
            }

        function createEditor(card) {
            var planId = parseInt(card.dataset.planId, 10);
            var svg = card.querySelector('.cutting-svg');
            var plateW = parseFloat(svg.dataset.plateWidth);
            var plateH = parseFloat(svg.dataset.plateHeight);
            var saveBtn = card.querySelector('.btn-save-plan');
            var resetBtn = card.querySelector('.btn-reset-plan');
            var rotateBtn = card.querySelector('.btn-rotate-piece');
            var infoLabel = card.querySelector('.piece-info');
            var wasteBadge = card.querySelector('.waste-badge');
            var wasteAreaEl = card.querySelector('.waste-area');
            var usedAreaEl = card.querySelector('.used-area');

            var state = {
                planId: planId,
                items: [],
                selectedId: null,
                dirty: false,
                dragging: false,
                dragItem: null,
                startMouse: null,
                startPos: null
            };
            editors[planId] = state;

            // Parça verilerini başlat
            svg.querySelectorAll('.piece-group').forEach(function(g) {
                state.items.push({
                    id: parseInt(g.dataset.id, 10),
                    x: parseFloat(g.dataset.x),
                    y: parseFloat(g.dataset.y),
                    width: parseFloat(g.dataset.width),
                    height: parseFloat(g.dataset.height),
                    rotated: g.dataset.rotation === '1',
                    el: g
                });
            });

            // İlk render'da label'ları parçaya sığacak şekilde ayarla
            state.items.forEach(updateTransform);

            function getSVGPoint(evt) {
                var pt = svg.createSVGPoint();
                pt.x = evt.clientX;
                pt.y = evt.clientY;
                return pt.matrixTransform(svg.getScreenCTM().inverse());
            }

            function updateTransform(item) {
                item.el.setAttribute('transform', 'translate(' + item.x + ',' + item.y + ')');
                item.el.dataset.x = item.x;
                item.el.dataset.y = item.y;
                item.el.dataset.width = item.width;
                item.el.dataset.height = item.height;
                item.el.dataset.rotation = item.rotated ? '1' : '0';

                var label = item.el.querySelector('.piece-label');
                if (label) {
                    label.setAttribute('x', formatNumber(item.width / 2, 1));
                    label.setAttribute('y', formatNumber(item.height / 2, 1));
                    var text = formatNumber(item.width, 0) + 'x' + formatNumber(item.height, 0);
                    var fs = fitFontSize(item, text);
                    label.setAttribute('font-size', formatNumber(fs, 1));
                    label.textContent = text;
                }
            }

            function overlaps(a, b) {
                return a.x < b.x + b.width && a.x + a.width > b.x &&
                       a.y < b.y + b.height && a.y + a.height > b.y;
            }

            function isOutOfBounds(item) {
                return item.x < 0 || item.y < 0 ||
                       item.x + item.width > plateW || item.y + item.height > plateH;
            }

            function validateSingle(item) {
                if (isOutOfBounds(item)) return false;
                for (var i = 0; i < state.items.length; i++) {
                    var other = state.items[i];
                    if (other.id !== item.id && overlaps(item, other)) return false;
                }
                return true;
            }

            function refreshVisuals() {
                state.items.forEach(function(item) {
                    var valid = validateSingle(item);
                    item.el.classList.toggle('invalid', !valid);
                    updateTransform(item);
                });
            }

            function renderItemInfo(item) {
                if (!item || !infoLabel) return;
                infoLabel.innerHTML = '<i class="fas fa-cube mr-1"></i>Cam #' + item.id +
                    ' &mdash; ' + formatNumber(item.width, 0) + ' x ' + formatNumber(item.height, 0) + ' mm' +
                    ' &middot; X:' + formatNumber(item.x, 0) + ' Y:' + formatNumber(item.y, 0) +
                    (item.rotated ? ' <span class="badge badge-info ml-1">Döndürülmüş</span>' : '');
            }

            function selectItem(item) {
                state.items.forEach(function(it) { it.el.classList.remove('selected'); });
                if (item) {
                    state.selectedId = item.id;
                    item.el.classList.add('selected');
                    rotateBtn.disabled = false;
                    infoLabel.classList.add('active');
                    renderItemInfo(item);
                } else {
                    state.selectedId = null;
                    rotateBtn.disabled = true;
                    infoLabel.classList.remove('active');
                    infoLabel.innerHTML = '<i class="fas fa-mouse-pointer mr-1"></i>Cam seçilmedi';
                }
            }

            function setDirty(dirty) {
                state.dirty = dirty;
                if (saveBtn) saveBtn.disabled = !dirty;
            }

            function recalcStats() {
                var used = 0;
                state.items.forEach(function(item) {
                    used += item.width * item.height;
                });
                used = used / 1000000; // mm2 -> m2
                var plateArea = (plateW * plateH) / 1000000;
                var waste = plateArea - used;
                var wastePct = plateArea === 0 ? 0 : (waste / plateArea) * 100;

                if (usedAreaEl) usedAreaEl.textContent = used.toFixed(2) + ' m²';
                if (wasteAreaEl) {
                    wasteAreaEl.textContent = waste.toFixed(2) + ' m² (%' + wastePct.toFixed(1) + ')';
                    wasteAreaEl.className = 'waste-area ' + (wastePct < 20 ? 'text-success' : wastePct < 35 ? 'text-warning' : 'text-danger');
                }
                if (wasteBadge) wasteBadge.textContent = 'Fire: %' + wastePct.toFixed(1);
            }

            function onPointerDown(evt) {
                if (isCompleted) return;
                var group = evt.target.closest('.piece-group');
                if (!group) return;
                evt.preventDefault();
                var item = state.items.find(function(i) { return i.id === parseInt(group.dataset.id, 10); });
                if (!item) return;

                selectItem(item);
                state.dragging = true;
                state.dragItem = item;
                state.startMouse = getSVGPoint(evt);
                state.startPos = { x: item.x, y: item.y };
                item.el.classList.add('dragging');
            }

            function onPointerMove(evt) {
                if (!state.dragging || !state.dragItem) return;
                evt.preventDefault();
                var pt = getSVGPoint(evt);
                var dx = pt.x - state.startMouse.x;
                var dy = pt.y - state.startMouse.y;
                var item = state.dragItem;
                item.x = state.startPos.x + dx;
                item.y = state.startPos.y + dy;
                refreshVisuals();
                recalcStats();
                renderItemInfo(item);
            }

            function onPointerUp(evt) {
                if (!state.dragging || !state.dragItem) return;
                var item = state.dragItem;
                item.el.classList.remove('dragging');

                // Çakışma / sınır dışındaysa eski konuma geri döndür
                if (!validateSingle(item)) {
                    item.x = state.startPos.x;
                    item.y = state.startPos.y;
                    toastr.warning('Geçersiz konum. Parça başka camla çakışıyor veya plaka dışına çıkıyor.');
                } else {
                    // Mm hassasiyetinde yuvarlama
                    item.x = Math.round(item.x * 10) / 10;
                    item.y = Math.round(item.y * 10) / 10;
                    if (item.x !== state.startPos.x || item.y !== state.startPos.y) {
                        setDirty(true);
                    }
                }
                refreshVisuals();
                recalcStats();
                state.dragging = false;
                state.dragItem = null;
            }

            svg.addEventListener('mousedown', onPointerDown);
            svg.addEventListener('mousemove', onPointerMove);
            window.addEventListener('mouseup', onPointerUp);
            svg.addEventListener('touchstart', function(e) { onPointerDown(e.touches[0]); }, { passive: false });
            svg.addEventListener('touchmove', function(e) { onPointerMove(e.touches[0]); }, { passive: false });
            window.addEventListener('touchend', function(e) { onPointerUp(e.changedTouches[0]); });

            // SVG dışına tıklayınca seçimi kaldır
            svg.addEventListener('click', function(evt) {
                if (evt.target === svg || evt.target.closest('.cutting-svg') === svg && !evt.target.closest('.piece-group')) {
                    selectItem(null);
                }
            });

            if (rotateBtn) {
                rotateBtn.addEventListener('click', function() {
                    var item = state.items.find(function(i) { return i.id === state.selectedId; });
                    if (!item) return;
                    var oldW = item.width, oldH = item.height;
                    item.width = oldH;
                    item.height = oldW;
                    item.rotated = !item.rotated;

                    // Döndürme sonrası sağ alt köşe dışarı çıkarsa sol üste kaydır
                    if (item.x + item.width > plateW) item.x = plateW - item.width;
                    if (item.y + item.height > plateH) item.y = plateH - item.height;
                    if (item.x < 0) item.x = 0;
                    if (item.y < 0) item.y = 0;

                    if (!validateSingle(item)) {
                        // Geri al
                        item.width = oldW;
                        item.height = oldH;
                        item.rotated = !item.rotated;
                        toastr.warning('Döndürme sonrası çakışma oluşuyor.');
                    } else {
                        setDirty(true);
                    }
                    refreshVisuals();
                    recalcStats();
                    selectItem(item);
                });
            }

            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    window.location.reload();
                });
            }

            if (saveBtn) {
                saveBtn.addEventListener('click', function() {
                    if (!state.dirty) return;
                    var payload = {
                        Items: state.items.map(function(item) {
                            return {
                                Id: item.id,
                                X: item.x,
                                Y: item.y,
                                WidthMm: item.width,
                                HeightMm: item.height,
                                IsRotated: item.rotated
                            };
                        })
                    };
                    saveBtn.disabled = true;
                    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Kaydediliyor';
                    $.ajax({
                        url: '@Url.Action("UpdateCuttingPlan", "WorkOrders")?id=' + workOrderId + '&planId=' + planId,
                        type: 'POST',
                        contentType: 'application/json; charset=utf-8',
                        data: JSON.stringify(payload),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': tokenValue
                        },
                        success: function(data) {
                            if (data.success) {
                                setDirty(false);
                                toastr.success('Kesim planı güncellendi.');
                                // Onaylı rozetini güncelle
                                var title = card.querySelector('.card-title');
                                if (title && !title.querySelector('.badge-success')) {
                                    var autoBadge = title.querySelector('.badge-secondary');
                                    if (autoBadge) autoBadge.remove();
                                    var badge = document.createElement('span');
                                    badge.className = 'badge badge-success ml-2';
                                    badge.innerHTML = '<i class="fas fa-check mr-1"></i>Onaylı';
                                    title.appendChild(badge);
                                }
                            } else {
                                toastr.error(data.message || 'Kaydetme başarısız.');
                            }
                        },
                        error: function(xhr) {
                            var msg = xhr.responseJSON?.message || 'Kaydetme sırasında bir hata oluştu.';
                            toastr.error(msg);
                        },
                        complete: function() {
                            saveBtn.disabled = !state.dirty;
                            saveBtn.innerHTML = '<i class="fas fa-save mr-1"></i> Değişiklikleri Kaydet';
                        }
                    });
                });
            }
        }

        document.querySelectorAll('.cutting-editor-card').forEach(createEditor);
    })();
</script>

<!-- Loading Overlay -->
<div id="optimizationOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9999; justify-content:center; align-items:center; flex-direction:column;">
    <div class="text-center text-white">
        <div class="spinner-border text-warning" style="width:4rem; height:4rem;" role="status"></div>
        <h4 class="mt-3">Kesim optimizasyonu çalıştırılıyor...</h4>
        <p class="text-muted">Lütfen bekleyiniz, bu işlem birkaç saniye sürebilir.</p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('btnRunOptimize');
        if (btn) {
            btn.addEventListener('click', function() {
                var overlay = document.getElementById('optimizationOverlay');
                overlay.style.display = 'flex';
                btn.disabled = true;

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var tokenValue = token ? token.value : '';

                $.ajax({
                    url: '@Url.Action("RunOptimization", "WorkOrders")',
                    type: 'POST',
                    data: { id: @Model.Id, __RequestVerificationToken: tokenValue },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(data) {
                        if (data.success) {
                            toastr.success('Kesim optimizasyonu tamamlandı!');
                            window.location.href = '@Url.Action("Details", "WorkOrders", new { id = Model.Id })';
                        } else {
                            overlay.style.display = 'none';
                            btn.disabled = false;
                            toastr.error('Optimizasyon sırasında bir hata oluştu.');
                        }
                    },
                    error: function() {
                        overlay.style.display = 'none';
                        btn.disabled = false;
                        toastr.error('Optimizasyon isteği başarısız oldu.');
                    }
                });
            });
        }
    });
</script>

@section Styles {
<style>
