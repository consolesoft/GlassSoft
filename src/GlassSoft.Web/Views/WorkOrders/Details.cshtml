@model GlassSoft.Application.DTOs.Production.WorkOrderDto
@{
    ViewData["Title"] = $"İş Emri - {Model.WorkOrderNumber}";
    ViewData["Breadcrumb"] = "Üretim & Kesim";
}

@if (TempData["Success"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function() { toastr.success('@TempData["Success"]'); });</script>
}

<div class="row">
    <div class="col-md-8">
        <!-- İş Emri Bilgileri -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-industry mr-2"></i>@Model.WorkOrderNumber</h3>
                <div class="card-tools">
                    @if (Model.IsCompleted)
                    {
                        <span class="badge badge-success" style="font-size: 0.9rem;"><i class="fas fa-check mr-1"></i>Tamamlandı</span>
                    }
                    else
                    {
                        <span class="badge badge-warning" style="font-size: 0.9rem;"><i class="fas fa-clock mr-1"></i>Devam Ediyor</span>
                    }
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>Siparişler:</strong></div>
                    <div class="col-md-9">
                        @if (Model.RelatedOrders.Any())
                        {
                            @foreach (var ro in Model.RelatedOrders)
                            {
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@ro.OrderId"
                                   class="badge badge-info mr-1" style="font-size: 0.85rem;">@ro.OrderNumber</a>
                                <small class="text-muted mr-3">@ro.CustomerTitle</small>
                            }
                        }
                        else if (Model.OrderId > 0)
                        {
                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderNumber</a>
                            <small class="text-muted ml-2">@Model.CustomerTitle</small>
                        }
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Planlanan Tarih:</strong></div>
                    <div class="col-md-3">@Model.PlannedDate.ToString("dd.MM.yyyy")</div>
                    <div class="col-md-3"><strong>Tamamlanma:</strong></div>
                    <div class="col-md-3">@(Model.CompletedAt?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                </div>
            </div>
        </div>

        <!-- Malzeme Listesi -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-list mr-2"></i>Malzeme Listesi (@Model.Lines.Count)</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Malzeme</th>
                            <th>Tip</th>
                            <th>En (mm)</th>
                            <th>Boy (mm)</th>
                            <th>m²</th>
                            <th>Adet</th>
                            <th>Kesim</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.ProductItemName</td>
                                <td>
                                    @if (line.MaterialType == "Glass")
                                    {
                                        <span class="badge badge-info">Cam</span>
                                    }
                                    else if (line.MaterialType == "Spacer")
                                    {
                                        <span class="badge badge-warning">Ara Parça</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Sarf</span>
                                    }
                                </td>
                                <td class="text-right">@(line.WidthMm > 0 ? line.WidthMm.ToString("0") : "-")</td>
                                <td class="text-right">@(line.HeightMm > 0 ? line.HeightMm.ToString("0") : "-")</td>
                                <td class="text-right">@(line.AreaM2 > 0 ? line.AreaM2.ToString("N4") : "-")</td>
                                <td class="text-center">@line.Quantity</td>
                                <td class="text-center">
                                    @if (line.MaterialType == "Glass")
                                    {
                                        if (line.IsOptimized)
                                        {
                                            <span class="badge badge-success"><i class="fas fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary"><i class="fas fa-clock"></i></span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Kesim Planları -->
        @if (Model.CuttingPlans.Any())
        {
            @foreach (var plan in Model.CuttingPlans)
            {
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-cut mr-2"></i>Kesim Planı #@plan.PlateIndex - @plan.ProductItemName
                            <small class="ml-2 text-muted">(@plan.PlateDisplayName mm)</small>
                        </h3>
                        <div class="card-tools">
                            <span class="badge badge-info mr-2">Fire: %@plan.WastePercentage.ToString("N1")</span>
                            <a asp-action="DownloadCsv" asp-route-id="@Model.Id" asp-route-planId="@plan.Id" class="btn btn-success btn-xs">
                                <i class="fas fa-file-csv mr-1"></i>CSV
                            </a>
                            <a asp-action="DownloadDxf" asp-route-id="@Model.Id" asp-route-planId="@plan.Id" class="btn btn-primary btn-xs ml-1">
                                <i class="fas fa-file-alt mr-1"></i>DXF
                            </a>
                        </div>
                    </div>
                    <div class="card-body text-center">
                        @{
                            var ic = System.Globalization.CultureInfo.InvariantCulture;
                            var svgScale = 0.15;
                            var svgW = ((double)plan.PlateWidthMm * svgScale).ToString(ic);
                            var svgH = ((double)plan.PlateHeightMm * svgScale).ToString(ic);
                            var plateW = ((double)plan.PlateWidthMm).ToString(ic);
                            var plateH = ((double)plan.PlateHeightMm).ToString(ic);
                            var colors = new[] { "#17a2b8", "#28a745", "#ffc107", "#dc3545", "#6f42c1", "#fd7e14", "#20c997", "#e83e8c" };
                        }
                        <svg width="@svgW" height="@svgH" viewBox="0 0 @plateW @plateH"
                             style="border: 2px solid #6c757d; background: #1a1a2e; max-width: 100%;">
                            <!-- Plaka çerçevesi -->
                            <rect x="0" y="0" width="@plateW" height="@plateH"
                                  fill="none" stroke="#6c757d" stroke-width="3" />
                            <!-- Parçalar -->
                            @{ var idx = 0; }
                            @foreach (var item in plan.Items)
                            {
                                var color = colors[idx % colors.Length];
                                var ix = ((double)item.X).ToString(ic);
                                var iy = ((double)item.Y).ToString(ic);
                                var iw = ((double)item.WidthMm).ToString(ic);
                                var ih = ((double)item.HeightMm).ToString(ic);
                                var tx = ((double)(item.X + item.WidthMm / 2)).ToString(ic);
                                var ty = ((double)(item.Y + item.HeightMm / 2)).ToString(ic);
                                var fs = Math.Max(30, Math.Min((double)item.WidthMm / 6, (double)item.HeightMm / 3)).ToString(ic);
                                var label = $"{item.WidthMm.ToString("0")}x{item.HeightMm.ToString("0")}";
                                <rect x="@ix" y="@iy" width="@iw" height="@ih"
                                      fill="@color" fill-opacity="0.6" stroke="@color" stroke-width="2" />
                                @Html.Raw($"<text x=\"{tx}\" y=\"{ty}\" text-anchor=\"middle\" dominant-baseline=\"central\" fill=\"white\" font-size=\"{fs}\">{label}</text>")
                                idx++;
                            }
                        </svg>
                        <div class="mt-2 small text-muted">
                            Plaka: @plan.PlateWidthMm.ToString("0") x @plan.PlateHeightMm.ToString("0") mm |
                            Kullanılan: @plan.UsedAreaM2.ToString("N2") m² |
                            Fire: @plan.WasteAreaM2.ToString("N2") m² (@plan.WastePercentage.ToString("N1")%)
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-md-4">
        <!-- Aksiyonlar -->
        @if (!Model.IsCompleted)
        {
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-bolt mr-2"></i>Aksiyonlar</h3>
                </div>
                <div class="card-body">
                    @if (!Model.CuttingPlans.Any())
                    {
                        <button type="button" class="btn btn-warning btn-block mb-2" id="btnRunOptimize">
                            <i class="fas fa-cut mr-1"></i> Kesim Optimizasyonu Çalıştır
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-warning btn-block mb-2" id="btnRunOptimize">
                            <i class="fas fa-redo mr-1"></i> Yeniden Optimize Et
                        </button>
                        <form asp-action="Complete" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-block mb-2">
                                <i class="fas fa-check-double mr-1"></i> Tamamla & Stok Düş
                            </button>
                        </form>
                    }
                </div>
            </div>
        }

        <!-- Özet -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-pie mr-2"></i>Özet</h3>
            </div>
            <div class="card-body">
                @{
                    var glassLines = Model.Lines.Where(l => l.MaterialType == "Glass").ToList();
                    var spacerLines = Model.Lines.Where(l => l.MaterialType == "Spacer").ToList();
                    var consumableLines = Model.Lines.Where(l => l.MaterialType == "Consumable").ToList();
                }
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-info">Cam</span> Malzeme:</span>
                    <strong>@glassLines.Count satır</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-warning">Ara Parça</span>:</span>
                    <strong>@spacerLines.Count satır</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span><span class="badge badge-secondary">Sarf</span> Malzeme:</span>
                    <strong>@consumableLines.Count satır</strong>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span>Kesim Planı:</span>
                    <strong>@Model.CuttingPlans.Count plaka</strong>
                </div>
                @if (Model.CuttingPlans.Any())
                {
                    var totalUsed = Model.CuttingPlans.Sum(p => p.UsedAreaM2);
                    var totalWaste = Model.CuttingPlans.Sum(p => p.WasteAreaM2);
                    var avgWaste = Model.CuttingPlans.Average(p => p.WastePercentage);
                    <div class="d-flex justify-content-between mb-2">
                        <span>Toplam Kullanım:</span>
                        <strong>@totalUsed.ToString("N2") m²</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Toplam Fire:</span>
                        <strong class="text-danger">@totalWaste.ToString("N2") m²</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Ort. Fire Oranı:</span>
                        <strong class="@(avgWaste < 20 ? "text-success" : avgWaste < 35 ? "text-warning" : "text-danger")">
                            %@avgWaste.ToString("N1")
                        </strong>
                    </div>
                }
            </div>
        </div>

        <!-- Yazdır -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-print mr-2"></i>Yazdır</h3>
            </div>
            <div class="card-body">
                <button class="btn btn-info btn-block" onclick="openPrintModal(@((int)GlassSoft.Domain.Enums.OutputType.Uretim), @Model.Id)">
                    <i class="fas fa-file-alt mr-1"></i> Üretim Emri
                </button>
            </div>
        </div>

        @if (!Model.IsCompleted)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="workOrderDeleteForm">
                @Html.AntiForgeryToken()
                <button type="button" class="btn btn-danger btn-block mb-2" id="btnWorkOrderDelete"><i class="fas fa-trash mr-1"></i> İş Emrini Sil</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary btn-block"><i class="fas fa-arrow-left mr-1"></i> Listeye Dön</a>
    </div>
</div>

<script>
$(function() {
    $('#btnWorkOrderDelete').on('click', function() {
        Swal.fire({
            title: 'İş emrini sil?',
            html: '<b>@Model.WorkOrderNumber</b> iş emrini silmek istediğinize emin misiniz?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'Vazgeç',
            confirmButtonColor: '#dc3545'
        }).then(function(r) { if (r.isConfirmed) $('#workOrderDeleteForm').submit(); });
    });
});
</script>

<!-- Loading Overlay -->
<div id="optimizationOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.7); z-index:9999; justify-content:center; align-items:center; flex-direction:column;">
    <div class="text-center text-white">
        <div class="spinner-border text-warning" style="width:4rem; height:4rem;" role="status"></div>
        <h4 class="mt-3">Kesim optimizasyonu çalıştırılıyor...</h4>
        <p class="text-muted">Lütfen bekleyiniz, bu işlem birkaç saniye sürebilir.</p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('btnRunOptimize');
        if (btn) {
            btn.addEventListener('click', function() {
                var overlay = document.getElementById('optimizationOverlay');
                overlay.style.display = 'flex';
                btn.disabled = true;

                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var tokenValue = token ? token.value : '';

                $.ajax({
                    url: '@Url.Action("RunOptimization", "WorkOrders")',
                    type: 'POST',
                    data: { id: @Model.Id, __RequestVerificationToken: tokenValue },
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    success: function(data) {
                        if (data.success) {
                            toastr.success('Kesim optimizasyonu tamamlandı!');
                            window.location.href = '@Url.Action("Details", "WorkOrders", new { id = Model.Id })';
                        } else {
                            overlay.style.display = 'none';
                            btn.disabled = false;
                            toastr.error('Optimizasyon sırasında bir hata oluştu.');
                        }
                    },
                    error: function() {
                        overlay.style.display = 'none';
                        btn.disabled = false;
                        toastr.error('Optimizasyon isteği başarısız oldu.');
                    }
                });
            });
        }
    });
</script>

@await Html.PartialAsync("_PrintModal")
