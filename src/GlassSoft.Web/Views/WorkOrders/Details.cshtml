        border-radius: 4px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        cursor: default;
    }
    .cutting-svg .plate-frame {
        fill: none;
        stroke: #6c757d;
        stroke-width: 3;
    }
    .piece-group {
        cursor: grab;
        transition: filter 0.15s;
    }
    .piece-group:hover .piece-rect {
        filter: brightness(1.15);
        stroke-width: 3;
    }
    .piece-group.dragging {
        cursor: grabbing;
    }
    .piece-group.dragging .piece-rect {
        fill-opacity: 0.85;
        stroke: #fff;
        stroke-width: 3;
        filter: drop-shadow(0 4px 12px rgba(0,0,0,0.5));
    }
    .piece-group.selected .piece-rect {
        stroke: #fff;
        stroke-width: 3;
        stroke-dasharray: 8 4;
        animation: dashMove 1s linear infinite;
    }
    .piece-group.invalid .piece-rect {
        fill: #dc3545 !important;
