    }
    .cutting-stats {
        padding: 0.75rem 1rem;
        background: rgba(15, 52, 96, 0.15);
        border-top: 1px solid var(--gs-border);
    }
    .cutting-stats .border-right {
        border-color: rgba(255,255,255,0.1) !important;
    }
    body:not(.dark-mode) .cutting-canvas-wrapper {
        background: #e9ecef;
    }
    body:not(.dark-mode) .cutting-svg {
        background: #f8f9fa;
        border-color: #adb5bd;
    }
    body:not(.dark-mode) .cutting-svg .plate-frame {
        stroke: #adb5bd;
    }
    body:not(.dark-mode) .cutting-toolbar {
        background: rgba(23, 162, 184, 0.08);
    }
    body:not(.dark-mode) .cutting-stats {
        background: rgba(23, 162, 184, 0.05);
    }
</style>
}

