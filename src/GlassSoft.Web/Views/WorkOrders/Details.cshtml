        transition: color 0.2s;
    }
    .cutting-status .piece-info.active {
        color: var(--gs-accent);
        font-weight: 600;
    }
    .cutting-canvas-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 1.5rem;
        background: #0f0f25;
        overflow: auto;
