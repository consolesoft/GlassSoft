@model IEnumerable<GlassSoft.Application.DTOs.Purchasing.SupplierDto>
@{
    ViewData["Title"] = "Tedarikçiler";
    ViewData["Breadcrumb"] = "Satın Alma";
}

@if (TempData["Success"] != null)
{
    <script>document.addEventListener('DOMContentLoaded', function() { toastr.success('@TempData["Success"]'); });</script>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-truck mr-2"></i>Tedarikçiler</h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus mr-1"></i> Yeni Tedarikçi
            </a>
        </div>
    </div>
    <div class="card-body">
        <table id="tblSuppliers" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Kod</th>
                    <th>Unvan</th>
                    <th>Şehir</th>
                    <th>Telefon</th>
                    <th>Sipariş</th>
                    <th>Durum</th>
                    <th style="width: 120px">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Code</strong></td>
                        <td>@item.Title</td>
                        <td>@(item.City ?? "-")</td>
                        <td>@(item.Phone ?? "-")</td>
                        <td class="text-center">@item.OrderCount</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Pasif</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-xs" title="Düzenle">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-info btn-xs" title="Siparişler">
                                <i class="fas fa-shopping-cart"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-xs btn-delete" title="Sil">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>$(document).ready(function() { $('#tblSuppliers').DataTable({ "order": [[0, "desc"]] }); });</script>
}
