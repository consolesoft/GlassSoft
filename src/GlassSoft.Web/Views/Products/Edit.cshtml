@model GlassSoft.Application.DTOs.Product.ProductItemUpdateDto
@{
    ViewData["Title"] = "Ürün Düzenle";
    ViewData["Breadcrumb"] = "Ürünler";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-edit mr-2"></i>Ürün Düzenle</h3>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Code">Ürün Kodu</label>
                                <input asp-for="Code" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="Name">Ürün Adı</label>
                                <input asp-for="Name" class="form-control" required />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ProductGroupId">Ürün Grubu</label>
                                <select asp-for="ProductGroupId" asp-items="@ViewBag.ProductGroups" class="form-control select2"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Unit">Birim</label>
                                <select asp-for="Unit" asp-items="@(ViewBag.Units as List<SelectListItem>)" class="form-control no-select2"></select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="UnitPrice">Birim Fiyat</label>
                                <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="ThicknessMm">Kalınlık (mm)</label>
                                <input asp-for="ThicknessMm" type="number" step="0.1" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group pt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsPlate" class="custom-control-input" id="isPlate">
                                    <label class="custom-control-label" for="isPlate">Cam Plaka Ürünü</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group pt-4">
                                <div class="custom-control custom-switch">
                                    <input asp-for="IsActive" class="custom-control-input" id="isActive">
                                    <label class="custom-control-label" for="isActive">Aktif</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Güncelle</button>
                    <a asp-action="Index" class="btn btn-secondary ml-2"><i class="fas fa-arrow-left mr-1"></i> Geri</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>$(document).ready(function() { $('.select2').select2({ theme: 'default' }); });</script>
}
