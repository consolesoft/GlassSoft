@model GlassSoft.Application.DTOs.Output.PrintTemplateCreateDto
@{
    ViewData["Title"] = "Yeni Şablon";
    ViewData["Breadcrumb"] = "Yazdır Şablonları";
}

<form asp-action="Create" method="post" id="templateForm">
    @Html.AntiForgeryToken()

    <!-- Üst: Şablon bilgileri + Hızlı Oluştur -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-plus-circle mr-2"></i>Yeni Şablon Oluştur</h3>
        </div>
        <div class="card-body pb-2">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Şablon Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: Özel Sipariş Fişi" required />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Çıktı Türü <span class="text-danger">*</span></label>
                        <select asp-for="OutputType" class="form-control" id="outputTypeSelect">
                            <option value="0">Sipariş</option>
                            <option value="1">Teslimat</option>
                            <option value="2">Üretim</option>
                            <option value="3">Cari Hareketleri</option>
                            <option value="4">Cari Ekstre</option>
                            <option value="5">Çıta Raporu</option>
                            <option value="6">Fiyatsız Sipariş</option>
                            <option value="7">Etiket</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Açıklama</label>
                        <input asp-for="Description" class="form-control" placeholder="Açıklama..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div>
                            <div class="custom-control custom-switch mt-2 d-inline-block mr-3">
                                <input type="checkbox" class="custom-control-input" id="isDefault" asp-for="IsDefault">
                                <label class="custom-control-label" for="isDefault">Varsayılan</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hızlı Oluştur Butonları -->
            <div class="row mb-2">
                <div class="col-12">
                    <div class="btn-group mr-3">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnQuickCreate">
                            <i class="fas fa-magic mr-1"></i> Tek Tuşla Oluştur
                        </button>
                    </div>
                    <div class="btn-group mr-3">
                        <button type="button" class="btn btn-outline-info btn-sm" data-toggle="collapse" data-target="#gallerySection">
                            <i class="fas fa-palette mr-1"></i> Hazır Tasarımlar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hazır Tasarım Galerisi (Kapalı) -->
    <div class="collapse" id="gallerySection">
        <div class="card card-outline card-primary">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label><i class="fas fa-file-alt mr-1"></i> Galeri Türü</label>
                        <select class="form-control form-control-sm" id="galleryType">
                            <option value="0">Sipariş Fişi</option>
                            <option value="1">Teslimat İrsaliyesi</option>
                            <option value="2">Üretim Emri</option>
                            <option value="3">Cari Hareket</option>
                            <option value="4">Cari Ekstre</option>
                            <option value="5">Çıta Raporu</option>
                            <option value="6">Fiyatsız Sipariş</option>
                            <option value="7">Etiket</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label><i class="fas fa-swatchbook mr-1"></i> Tasarım Stili</label>
                        <div class="d-flex" id="styleCards">
                            <div class="card gallery-style-card active mr-2" data-style="Modern" style="cursor:pointer;min-width:100px;">
                                <div class="card-body text-center p-2">
                                    <i class="fas fa-gem text-primary"></i><br><small>Modern</small>
                                </div>
                            </div>
                            <div class="card gallery-style-card mr-2" data-style="Klasik" style="cursor:pointer;min-width:100px;">
                                <div class="card-body text-center p-2">
                                    <i class="fas fa-landmark text-warning"></i><br><small>Klasik</small>
                                </div>
                            </div>
                            <div class="card gallery-style-card" data-style="Minimal" style="cursor:pointer;min-width:100px;">
                                <div class="card-body text-center p-2">
                                    <i class="fas fa-feather-alt text-success"></i><br><small>Minimal</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small"><i class="fas fa-eye mr-1"></i> Önizleme</span>
                        <button type="button" class="btn btn-success btn-sm" id="btnUseTemplate">
                            <i class="fas fa-check mr-1"></i> Bu Tasarımı Kullan
                        </button>
                    </div>
                    <iframe id="galleryPreviewFrame" style="width:100%; height:400px; border:1px solid #ddd; background:#fff;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Editör Modları: Tab -->
    <div class="card">
        <div class="card-header p-0">
            <ul class="nav nav-pills p-2">
                <li class="nav-item">
                    <a class="nav-link active" id="veTabVisual" href="#" onclick="return false;">
                        <i class="fas fa-th-large mr-1"></i> Görsel Editör
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="veTabHtml" href="#" onclick="return false;">
                        <i class="fas fa-code mr-1"></i> HTML Kodu
                    </a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Görsel Editör -->
    <div id="visualEditorPanel">
        <div class="row">
            <!-- Sol: Bileşen Paleti -->
            <div class="col-md-2">
                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-puzzle-piece mr-1"></i> Bileşenler</h3>
                    </div>
                    <div class="card-body p-2" id="vePalette"></div>
                </div>
            </div>

            <!-- Orta: Canvas -->
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-object-group mr-1"></i> Şablon Tasarımı</h3>
                        <div class="card-tools">
                            <span class="badge badge-info" id="blockCount">0 blok</span>
                        </div>
                    </div>
                    <div class="card-body p-2" id="visualCanvas" style="min-height:400px; background:#1a1a2e; border-radius:4px;"></div>
                </div>
            </div>

            <!-- Sağ: Özellikler + Önizleme -->
            <div class="col-md-3">
                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-sliders-h mr-1"></i> Özellikler</h3>
                    </div>
                    <div class="card-body p-2" id="veProperties" style="max-height:350px; overflow-y:auto;"></div>
                </div>

                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-eye mr-1"></i> Önizleme</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-info btn-xs" id="btnPreview"><i class="fas fa-sync"></i></button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <iframe id="previewFrame" style="width:100%; height:300px; border:none; background:#fff;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HTML Editör (gizli başlar) -->
    <div id="htmlEditorPanel" style="display:none;">
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-code mr-1"></i> HTML İçerik</h3>
                    </div>
                    <div class="card-body p-2">
                        <textarea asp-for="HtmlContent" class="form-control" rows="25"
                                  style="font-family: 'Courier New', monospace; font-size: 12px; tab-size: 4; background: #1e1e1e; color: #d4d4d4; border: 1px solid #444;"
                                  placeholder="HTML şablon içeriği..." required></textarea>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-tags mr-1"></i> Alanlar</h3>
                    </div>
                    <div class="card-body p-2" style="max-height:400px; overflow-y:auto;">
                        <div id="placeholderBadges"></div>
                    </div>
                </div>
                <div class="card">
                    <div class="card-header py-2">
                        <h3 class="card-title small"><i class="fas fa-eye mr-1"></i> Önizleme</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-info btn-xs" id="btnPreviewHtml"><i class="fas fa-sync"></i></button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <iframe id="previewFrameHtml" style="width:100%; height:350px; border:none; background:#fff;"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Kaydet -->
    <div class="card">
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left mr-1"></i> Geri</a>
        </div>
    </div>
</form>

@section Styles {
    <style>
        /* Galeri */
        .gallery-style-card { border: 2px solid transparent; transition: all 0.3s; }
        .gallery-style-card.active { border-color: #007bff !important; box-shadow: 0 0 8px rgba(0,123,255,0.3); }
        .gallery-style-card:hover { transform: translateY(-2px); }

        /* Görsel Editör */
        .ve-palette-item {
            display: flex; align-items: center; gap: 8px; padding: 8px 10px; margin-bottom: 4px;
            border: 1px solid rgba(255,255,255,0.1); border-radius: 6px; cursor: pointer;
            transition: all 0.2s; font-size: 12px; color: #ccc;
        }
        .ve-palette-item:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2); transform: translateX(2px); }
        .ve-palette-item i { font-size: 14px; width: 18px; text-align: center; }

        #visualCanvas { transition: background 0.3s; }

        .ve-block {
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            border-radius: 6px; margin-bottom: 6px; transition: all 0.2s; overflow: hidden;
        }
        .ve-block:hover { border-color: rgba(255,255,255,0.25); }
        .ve-block.active { border-color: #007bff; box-shadow: 0 0 0 2px rgba(0,123,255,0.3); }

        .ve-block-header {
            display: flex; align-items: center; padding: 4px 8px;
            background: rgba(255,255,255,0.03); border-bottom: 1px solid rgba(255,255,255,0.05);
            font-size: 11px; color: #aaa;
        }
        .ve-block-grip { cursor: grab; margin-right: 8px; opacity: 0.5; }
        .ve-block-grip:hover { opacity: 1; }
        .ve-block-type { flex: 1; }
        .ve-block-actions { display: flex; gap: 3px; }
        .ve-block-actions .btn { padding: 1px 5px; font-size: 10px; }

        .ve-block-preview { padding: 4px; background: #fff; color: #333; font-size: 11px; }

        .ve-ghost { opacity: 0.4; background: rgba(0,123,255,0.1) !important; }

        .ve-empty { border: 2px dashed rgba(255,255,255,0.15); border-radius: 8px; margin: 20px; }

        .ve-prop-header { font-weight: bold; font-size: 13px; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid rgba(255,255,255,0.1); }

        /* Nav pills override */
        .nav-pills .nav-link { color: #adb5bd; border-radius: 4px; padding: 6px 16px; font-size: 13px; }
        .nav-pills .nav-link.active { background: #007bff; color: #fff; }
        .nav-pills .nav-link:hover:not(.active) { color: #fff; background: rgba(255,255,255,0.1); }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/template-editor.js"></script>
    <script>
        var selectedStyle = 'Modern';

        function loadGalleryPreview() {
            var type = $('#galleryType').val();
            $.get('@Url.Action("GalleryTemplate", "PrintTemplates")', { type: type, style: selectedStyle }, function (html) {
                var frame = document.getElementById('galleryPreviewFrame');
                var doc = frame.contentDocument || frame.contentWindow.document;
                doc.open(); doc.write(html); doc.close();
            });
        }

        function loadPlaceholders() {
            var type = $('#outputTypeSelect').val();
            $.get('@Url.Action("Placeholders", "PrintTemplates")', { type: type }, function (data) {
                var html = '';
                data.forEach(function (p) {
                    html += '<span class="badge badge-outline badge-info m-1 placeholder-badge" ' +
                        'style="cursor:pointer;font-size:11px;padding:4px 6px;border:1px solid #17a2b8" ' +
                        'data-placeholder="{{' + p + '}}">{{' + p + '}}</span>';
                });
                $('#placeholderBadges').html(html);
            });
        }

        $(document).ready(function () {
            // Görsel Editör init
            TemplateEditor.init();
            loadPlaceholders();

            // Galeri
            $('#galleryType').on('change', loadGalleryPreview);
            $(document).on('click', '.gallery-style-card', function () {
                $('.gallery-style-card').removeClass('active');
                $(this).addClass('active');
                selectedStyle = $(this).data('style');
                loadGalleryPreview();
            });

            // Galeri açılınca yükle
            $('#gallerySection').on('shown.bs.collapse', loadGalleryPreview);

            // Tasarımı kullan
            $('#btnUseTemplate').on('click', function () {
                var type = $('#galleryType').val();
                $.get('@Url.Action("GalleryTemplate", "PrintTemplates")', { type: type, style: selectedStyle }, function (html) {
                    $('#HtmlContent').val(html);
                    $('#outputTypeSelect').val(type).trigger('change');
                    // HTML moduna geç
                    $('#veTabHtml').click();
                    var typeNames = { '0': 'Sipariş Fişi', '1': 'Teslimat İrsaliyesi', '2': 'Üretim Emri', '3': 'Cari Hareket', '4': 'Cari Ekstre' };
                    if (!$('#Name').val()) $('#Name').val(selectedStyle + ' ' + typeNames[type]);
                    toastr.success(selectedStyle + ' tasarım yüklendi!');
                    $('#gallerySection').collapse('hide');
                    setTimeout(function () { $('#btnPreviewHtml').click(); }, 300);
                });
            });

            // Hızlı oluştur
            $('#btnQuickCreate').on('click', function () {
                var type = $('#outputTypeSelect').val();
                TemplateEditor.quickCreate(type);
                var typeNames = { '0': 'Sipariş Fişi', '1': 'Teslimat İrsaliyesi', '2': 'Üretim Emri', '3': 'Cari Hareket', '4': 'Cari Ekstre' };
                if (!$('#Name').val()) $('#Name').val('Özel ' + typeNames[type]);
                // Görsel moda geç
                $('#veTabVisual').click();
                toastr.success('Şablon bloklarla oluşturuldu! Sürükle-bırak ile düzenleyebilirsiniz.');
            });

            // Çıktı türü değişince
            $('#outputTypeSelect').on('change', loadPlaceholders);

            // Placeholder tıklama (HTML modunda)
            $(document).on('click', '.placeholder-badge', function () {
                var ph = $(this).data('placeholder');
                var textarea = document.getElementById('HtmlContent');
                var start = textarea.selectionStart;
                var end = textarea.selectionEnd;
                var text = textarea.value;
                textarea.value = text.substring(0, start) + ph + text.substring(end);
                textarea.selectionStart = textarea.selectionEnd = start + ph.length;
                textarea.focus();
            });

            // HTML önizleme
            $('#btnPreview, #btnPreviewHtml').on('click', function () {
                TemplateEditor.refreshPreview();
                // HTML moddaki iframe da güncelle
                var html = $('#HtmlContent').val();
                var frame2 = document.getElementById('previewFrameHtml');
                if (frame2) {
                    var doc2 = frame2.contentDocument || frame2.contentWindow.document;
                    doc2.open(); doc2.write(html); doc2.close();
                }
            });

            // Blok sayısı güncelle
            var observer = new MutationObserver(function () {
                var count = $('#visualCanvas .ve-block').length;
                $('#blockCount').text(count + ' blok');
            });
            observer.observe(document.getElementById('visualCanvas'), { childList: true });
        });
    </script>
}
