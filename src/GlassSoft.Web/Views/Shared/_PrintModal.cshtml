<!-- Yazdır Modal -->
<div class="modal fade" id="printModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info">
                <h5 class="modal-title"><i class="fas fa-print mr-2"></i>Yazdır</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="printOutputType" />
                <input type="hidden" id="printEntityId" />

                <div class="form-group">
                    <label>Şablon Seçin</label>
                    <select id="printTemplateSelect" class="form-control">
                        <option value="">Yükleniyor...</option>
                    </select>
                </div>

                <div id="dateRangeSection" style="display:none">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Başlangıç Tarihi</label>
                                <input type="date" id="printStartDate" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Bitiş Tarihi</label>
                                <input type="date" id="printEndDate" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info" id="btnPrintPreview">
                    <i class="fas fa-eye mr-1"></i> Önizle
                </button>
                <button type="button" class="btn btn-primary" id="btnPrintDirect">
                    <i class="fas fa-print mr-1"></i> Yazdır
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    // URL'leri data attribute'a kaydet (Razor burada çalışır, jQuery'ye gerek yok)
    document.getElementById('printModal').setAttribute('data-templates-url', '@Url.Action("GetTemplates", "Output")');
    document.getElementById('printModal').setAttribute('data-render-url', '@Url.Action("Render", "Output")');
</script>
