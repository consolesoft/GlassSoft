@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="mb-4">
                    <i class="@Model.StatusIcon fa-4x text-danger"></i>
                </div>
                <h1 class="display-4 text-danger mb-2">@Model.StatusCode</h1>
                <h3 class="mb-3">@Model.StatusTitle</h3>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger text-left mt-3">
                        <strong><i class="fas fa-bug mr-2"></i>Hata Detayı:</strong>
                        <p class="mb-0 mt-2">@Model.ErrorMessage</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ErrorDetail))
                {
                    <div class="mt-3 text-left">
                        <button class="btn btn-outline-secondary btn-sm" type="button" data-toggle="collapse" data-target="#errorStack">
                            <i class="fas fa-code mr-1"></i> Teknik Detaylar
                        </button>
                        <div class="collapse mt-2" id="errorStack">
                            <pre class="bg-dark text-light p-3 rounded small" style="max-height: 300px; overflow-y: auto; white-space: pre-wrap; word-break: break-all;">@Model.ErrorDetail</pre>
                        </div>
                    </div>
                }

                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small mt-3">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                <div class="mt-4">
                    <a href="/" class="btn btn-primary mr-2">
                        <i class="fas fa-home mr-1"></i> Ana Sayfa
                    </a>
                    <button onclick="history.back()" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Geri Dön
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
