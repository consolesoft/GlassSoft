@using Microsoft.AspNetCore.Identity
@using GlassSoft.Domain.Entities.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - GLASSOFT</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css">
    <!-- overlayScrollbars -->
    <link rel="stylesheet" href="~/lib/overlayScrollbars/css/OverlayScrollbars.min.css">
    <!-- Select2 -->
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css">
    <!-- DataTables -->
    <link rel="stylesheet" href="~/lib/datatables-bs4/dataTables.bootstrap4.min.css">
    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css">
    <!-- Custom -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed dark-mode" id="mainBody">
<div class="wrapper">

    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-dark" id="mainNavbar">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
            <li class="nav-item d-none d-sm-inline-block">
                <a href="~/" class="nav-link">Ana Sayfa</a>
            </li>
        </ul>

        <ul class="navbar-nav ml-auto">
            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item dropdown">
                    <a class="nav-link" data-toggle="dropdown" href="#">
                        <i class="fas fa-user"></i>
                        <span class="ml-1">@UserManager.GetUserName(User)</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a href="#" class="dropdown-item"><i class="fas fa-user-cog mr-2"></i> Profil</a>
                        <div class="dropdown-divider"></div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt mr-2"></i> Çıkış Yap</button>
                        </form>
                    </div>
                </li>
            }
            <li class="nav-item">
                <a class="nav-link" href="#" role="button" id="themeToggle" title="Tema Değiştir">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                    <i class="fas fa-expand-arrows-alt"></i>
                </a>
            </li>
        </ul>
    </nav>

    @await Html.PartialAsync("_Sidebar")

    <!-- Content Wrapper -->
    <div class="content-wrapper">
        <!-- Content Header -->
        <div class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0">@ViewData["Title"]</h1>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-sm-right">
                            <li class="breadcrumb-item"><a href="~/">Ana Sayfa</a></li>
                            @if (ViewData["Breadcrumb"] != null)
                            {
                                <li class="breadcrumb-item active">@ViewData["Breadcrumb"]</li>
                            }
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                @RenderBody()
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <strong>&copy; @DateTime.Now.Year <a href="#">ConsoleSoft</a>.</strong> GLASSOFT - Cam Sektörü ERP
        <div class="float-right d-none d-sm-inline-block">
            <b>Sürüm</b> 1.0.0
        </div>
    </footer>

</div>

<!-- jQuery -->
<script src="~/lib/jquery/jquery.min.js"></script>
<!-- Bootstrap 4 -->
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
<!-- overlayScrollbars -->
<script src="~/lib/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
<!-- AdminLTE -->
<script src="~/lib/admin-lte/js/adminlte.min.js"></script>
<!-- DataTables -->
<script src="~/lib/datatables/jquery.dataTables.min.js"></script>
<script src="~/lib/datatables-bs4/dataTables.bootstrap4.min.js"></script>
<script>
    // DataTables global default: tüm tablolarda sayfa/arama/sıralama durumunu hatırla.
    // Kullanıcı listeden detaya gidip geri dönünce kaldığı yerden devam etsin.
    // Path bazlı key kullanılır — her sayfa kendi state'ini tutar, sayfalar birbirine karışmaz.
    if (window.jQuery && jQuery.fn && jQuery.fn.dataTable) {
        jQuery.extend(true, jQuery.fn.dataTable.defaults, {
            stateSave: true,
            stateDuration: 60 * 60 * 24, // 1 gün (saniye)
            stateSaveCallback: function(settings, data) {
                try {
                    var key = 'DT_state_' + location.pathname + '_' + settings.sTableId;
                    localStorage.setItem(key, JSON.stringify(data));
                } catch (e) {}
            },
            stateLoadCallback: function(settings) {
                try {
                    var key = 'DT_state_' + location.pathname + '_' + settings.sTableId;
                    var raw = localStorage.getItem(key);
                    return raw ? JSON.parse(raw) : null;
                } catch (e) { return null; }
            }
        });
    }
</script>
<!-- Select2 -->
<script src="~/lib/select2/js/select2.min.js"></script>
<!-- SweetAlert2 -->
<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
<!-- Toastr -->
<script src="~/lib/toastr/toastr.min.js"></script>
<!-- Site JS -->
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
