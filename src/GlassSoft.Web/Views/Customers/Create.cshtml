@model GlassSoft.Application.DTOs.Sales.CustomerCreateDto
@{
    ViewData["Title"] = "Yeni Cari";
    ViewData["Breadcrumb"] = "Satış";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-plus mr-2"></i>Yeni Cari</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Code">Cari Kodu</label>
                                <input asp-for="Code" class="form-control" placeholder="Örn: CRI001" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Title">Unvan</label>
                                <input asp-for="Title" class="form-control" placeholder="Firma veya kişi adı" required />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="CustomerType">Cari Türü</label>
                                <select asp-for="CustomerType" class="form-control">
                                    <option value="0">Müşteri</option>
                                    <option value="1">Tedarikçi</option>
                                    <option value="2">Müşteri + Tedarikçi</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="TaxNumber">Vergi No</label>
                                <input asp-for="TaxNumber" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="TaxOffice">Vergi Dairesi</label>
                                <input asp-for="TaxOffice" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Currency">Para Birimi</label>
                                <select asp-for="Currency" class="form-control">
                                    <option value="TRY">TRY - Türk Lirası</option>
                                    <option value="USD">USD - Amerikan Doları</option>
                                    <option value="EUR">EUR - Euro</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Phone">Telefon</label>
                                <input asp-for="Phone" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="Email">E-posta</label>
                                <input asp-for="Email" type="email" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="City">Şehir</label>
                                <input asp-for="City" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="Address">Adres</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsActive" class="custom-control-input" id="isActive" checked>
                            <label class="custom-control-label" for="isActive">Aktif</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i> Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary ml-2"><i class="fas fa-arrow-left mr-1"></i> Geri</a>
                </div>
            </form>
        </div>
    </div>
</div>
